# Vertaalpijplijn-configuratie voor crunch_uml (backend 'pipeline').
# De preflight van crunch_uml controleert zelf of Ollama draait, welke
# modellen gepulld zijn (prefixen lossen op naar de hoogste lokale tag) en
# welke termbanken laden; ontbrekende onderdelen degraderen met een
# waarschuwing. Online diensten (Google/Bing) staan standaard UIT en gaan
# alleen aan met CRUNCH_UML_TRANSLATE_ALLOW_ONLINE=1.
# Modelrollen onderbouwd met tools/benchmark_translation_models.py (crunch_uml):
# beide werkpaarden 100% glossarium-naleving; llama3.3:70b beste arbiter.
CRUNCH_UML_TRANSLATE_BACKEND=pipeline
CRUNCH_UML_OLLAMA_URL=http://localhost:11434
CRUNCH_UML_TERMBANKS=tools/termbanken/
CRUNCH_UML_TERMBANK_MAX_AGE_DAYS=730
CRUNCH_UML_LLM_WORKHORSES=mistral-small,qwen2.5:14b
CRUNCH_UML_LLM_HEAVY=llama3.3:70b

# FTP to test server overwrite user and password in .env-secret!
FTP_HOST="CHANGE_ME"
FTP_REMOTE_DIR="ggm.e-space.nl"
FTP_LOCAL_DIR="site"

# --- Linked Data publiceren naar de LIVE Virtuoso via SSH (geen stack-redeploy) ---
# Gebruik:  task generate:lod VERSION=v3.0.0  &&  task publish:lod VERSION=v3.0.0
SSH_HOST="lod-ggm"                                   # ssh-config profiel van de stack-host
LOD_LOCAL_PORT="8080"              # host-poort waarop Caddy op de server luistert (HTTP_BIND)
LOD_DROP="/home/gemeentelijkgegevensmodel-lod/ggm-lod"   # dropmap op de server (= LOD_HOST_DIR van de stack)
