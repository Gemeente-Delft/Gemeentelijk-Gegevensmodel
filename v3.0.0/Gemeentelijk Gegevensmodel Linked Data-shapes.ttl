            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "objectidentificatie"@nl ;
            sh:nodeKind sh:IRI ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/onderzoek/objectidentificatie-pand> ],
