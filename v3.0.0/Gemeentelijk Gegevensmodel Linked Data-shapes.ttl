        [ sh:datatype xsd:string ;
            sh:description "Beschrijving van Ã©Ã©n of meerdere soortnamen van het groenobject. Naam van de soort waartoe de boom of de beplanting van het groenobject behoort, conform de 'Naamlijst van houtige gewassen en vaste planten'."@nl ;
