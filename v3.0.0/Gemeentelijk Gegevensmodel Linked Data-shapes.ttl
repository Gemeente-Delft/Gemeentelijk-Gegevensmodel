<https://lod.gemeentelijkgegevensmodel.nl/shapes/kern/bag/standplaats> a sh:NodeShape ;
    rdfs:label "Standplaats"@nl ;
    dcterms:identifier "EAID_86952BDA_ADF6_4ff0_B8C7_BA3AA889A40B" ;
    sh:property [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Versie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/versie> ],
        [ sh:datatype xsd:date ;
            sh:description """Definitie
BeginGeldigheid is de datum waarop een versie van een BAG-object geldig is in de werkelijkheid conform de ingangsdatum in het brondocument. Dit tijdstip wordt vastgelegd in de beginGeldigheid. Als er geen expliciete ingangsdatum van geldigheid is opgenomen, wordt de datum van het brondocument overgenomen.
Beschrijving
Vanaf deze datum zijn gegevens in de BAG geldig. Bij elke verandering in de BAG zetten we een datum BeginGeldigheid . Wanneer er geen startdatum van geldigheid is, dan gebruiken we de datum van het brondocument als startdatum"""@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Datum Begin Geldigheid"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/datum-begin-geldigheid> ],
        [ sh:datatype xsd:date ;
            sh:description "De datum waarop de object in de BAG formeel is ingetrokken."@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Datum Einde"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/datum-einde> ],
        [ sh:class <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusstandplaats> ;
            sh:description "De fase van de levenscyclus van een STANDPLAATS waarin de betreffende STANDPLAATS zich bevindt."@nl ;
            sh:in ( <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusstandplaats/plaats-aangewezen> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusstandplaats/plaats-ingetrokken> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusstandplaats/onbekend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusstandplaats/leeg> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Status"@nl ;
            sh:nodeKind sh:IRI ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/status> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Een aanduiding waarmee kan worden aangegeven dat een object in de registratie is opgenomen als gevolg van een feitelijke constatering, zonder dat er op het moment van opname sprake is van een formele grondslag voor deze opname."@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Geconstateerd"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/geconstateerd> ],
        [ sh:datatype xsd:integer ;
            sh:description "Het unieke nummer van het brondocument"@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "documentnummer"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/documentnummer> ],
        [ sh:datatype xsd:date ;
            sh:description "De datum waarop het brondocument is vastgesteld"@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "documentdatum"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/documentdatum> ],
        [ sh:datatype geo:wktLiteral ;
            sh:description "Loodrechte bovenaanzicht van de standplaats in het Nationale Rijksdriehoekstelsel, inclusief alle zichbare en onzichtbare delen boven en onder de grond, maar exclusief alle delen die kunnen bewegen ten opzichte van de aarde"@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Geometrie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/geometrie> ],
        [ sh:datatype xsd:date ;
            sh:description "Datum waarop het object is ontstaan"@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Datum Ingang"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/datum-ingang> ],
        [ sh:datatype xsd:date ;
            sh:description """Definitie
EindGeldigheid is de datum waarop de periode van geldigheid van een versie van een BAG-object eindigt. Bijvoorbeeld als gevolg van de vaststelling van een nieuw brondocument. Wanneer er geen tijdstip is ingevuld, dan is de versie nog geldig. Dit tijdstip wordt vastgelegd in de eindGeldigheid.
Beschrijving
Tot deze datum zijn gegevens in de BAG geldig. Iedere keer als een gegeven van een object verandert, zetten we bij de laatste gegevens van dat object een datum EindGeldigheid. Wanneer er geen tijdstip EindGeldigheid is ingevuld, is die versie van het object nog geldig."""@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Datum Einde Geldigheid"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/datum-einde-geldigheid> ],
        [ sh:datatype xsd:string ;
            sh:description "De unieke aanduiding van een STANDPLAATS."@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Identificatie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/identificatie> ] ;
    sh:targetClass <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats> .

