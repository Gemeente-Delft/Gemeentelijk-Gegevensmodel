<https://lod.gemeentelijkgegevensmodel.nl/shapes/kern/bag/buurt> a sh:NodeShape ;
    rdfs:label "Buurt"@nl ;
    dcterms:identifier "EAID_38649FF6_88C6_437d_AF8E_A9023D55E16C" ;
    sh:property [ sh:datatype geo:wktLiteral ;
            sh:description "De tweedimensionale geometrische representatie van de omtrekken van de buurt."@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "geometrie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/geometrie> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "identificatie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/identificatie> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "versie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/versie> ],
        [ sh:datatype xsd:date ;
            sh:description "Datum waarop het object is ontstaan"@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "datumIngang"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/datumingang> ],
        [ sh:class <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/wijk> ;
            sh:description "De wijk waarin de buurt is gelegen."@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "ligt in"@nl ;
            sh:nodeKind sh:IRI ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/ligt-in> ],
        [ sh:datatype xsd:string ;
            sh:description "De naam van de buurt, zoals die door het CBS wordt gebruikt."@nl ;
            sh:maxCount 1 ;
            sh:maxLength 40 ;
            sh:minCount 1 ;
            sh:name "naam"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/naam> ],
        [ sh:datatype xsd:date ;
            sh:description """Definitie
EindGeldigheid is de datum waarop de periode van geldigheid van een versie van een BAG-object eindigt. Bijvoorbeeld als gevolg van de vaststelling van een nieuw brondocument. Wanneer er geen tijdstip is ingevuld, dan is de versie nog geldig. Dit tijdstip wordt vastgelegd in de eindGeldigheid.
Beschrijving
Tot deze datum zijn gegevens in de BAG geldig. Iedere keer als een gegeven van een object verandert, zetten we bij de laatste gegevens van dat object een datum EindGeldigheid. Wanneer er geen tijdstip EindGeldigheid is ingevuld, is die versie van het object nog geldig."""@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "eindGeldigheid"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/eindgeldigheid> ],
        [ sh:class <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusopenbareruimte> ;
            sh:in ( <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusopenbareruimte/naamgeving-uitgegeven> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusopenbareruimte/naamgeving-ingetrokken> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusopenbareruimte/onbekend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusopenbareruimte/leeg> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "status"@nl ;
            sh:nodeKind sh:IRI ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/status> ],
        [ sh:datatype xsd:date ;
            sh:description """Definitie
BeginGeldigheid is de datum waarop een versie van een BAG-object geldig is in de werkelijkheid conform de ingangsdatum in het brondocument. Dit tijdstip wordt vastgelegd in de beginGeldigheid. Als er geen expliciete ingangsdatum van geldigheid is opgenomen, wordt de datum van het brondocument overgenomen.
Beschrijving
Vanaf deze datum zijn gegevens in de BAG geldig. Bij elke verandering in de BAG zetten we een datum BeginGeldigheid . Wanneer er geen startdatum van geldigheid is, dan gebruiken we de datum van het brondocument als startdatum"""@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "beginGeldigheid"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/begingeldigheid> ],
        [ sh:class <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/boolean> ;
            sh:in ( <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/boolean/ja> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/boolean/nee> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/boolean/onbekend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/boolean/leeg> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Geconstateerd"@nl ;
            sh:nodeKind sh:IRI ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/geconstateerd> ],
        [ sh:datatype xsd:string ;
            sh:description "De code behorende bij de naam van de buurt."@nl ;
            sh:maxCount 1 ;
            sh:maxLength 2 ;
            sh:minCount 1 ;
            sh:name "code"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/code> ],
        [ sh:datatype xsd:date ;
            sh:description "De datum waarop de object in de BAG formeel is ingetrokken."@nl ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "datumEinde"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt/datumeinde> ] ;
    sh:targetClass <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/buurt> .

