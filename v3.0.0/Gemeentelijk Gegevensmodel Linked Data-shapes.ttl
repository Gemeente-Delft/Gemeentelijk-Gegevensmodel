<https://lod.gemeentelijkgegevensmodel.nl/shapes/interne-organisatie/ict/attribuutsoort> a sh:NodeShape ;
    rdfs:label "Attribuutsoort"@nl ;
    dcterms:identifier "EAID_8D273DE5_3529_4652_BCA1_F86B28F26017" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "De registratie in wiens catalogus het objecttype is gespecificeerd (oftewel de registratie waar het objecttype deel van uitmaakt). Deze specificatie is toegevoegd omdat het wel duidelijk moet zijn in welke (basis)registratie of informatiemodel het objecttype voorkomt (indien van toepassing)."@nl ;
            sh:maxCount 1 ;
            sh:maxLength 80 ;
            sh:name "herkomst"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/herkomst> ],
        [ sh:datatype xsd:string ;
            sh:description """Alleen van toepassing wanneer het type van het attribuutsoort een primitief datatype is.
De verzameling van waarden die gegevens van deze attribuutsoort kunnen hebben, dat wil zeggen het waardenbereik, uitgedrukt in een specifieke structuur."""@nl ;
            sh:maxCount 1 ;
            sh:maxLength 40 ;
            sh:name "patroon"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/patroon> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 80 ;
            sh:name "naam"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/naam> ],
        [ sh:datatype xsd:string ;
            sh:description """Deze indicatie geeft aan hoeveel keer waarden van deze attribuutsoort kunnen voorkomen bij een object van het betreffende objecttype, of bij het betreffende gegevensgroeptype:
0..1: is soms niet beschikbaar
1 : is altijd beschikbaar
0..*: is niet altijd beschikbaar, kan
meerdere malen voorkomen 1..*: is altijd beschikbaar, kan
meerdere malen voorkomen
Indien een attribuutsoort deel uit maakt van een gegevensgroeptype, dan wordt de kardinaliteit vermeld van het attribuutsoort binnen het gegevensgroeptype. Voor de uiteindelijke kardinaliteit van hoe vaak een gegeven voorkomt bij het object moet rekening gehouden worden met de kardinaliteit van de gegevensgroep en met de kardinaliteit van de attribuutsoort."""@nl ;
            sh:maxCount 1 ;
            sh:maxLength 40 ;
            sh:name "kardinaliteit"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/kardinaliteit> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Aanduiding dat attribuutsoort onderdeel uitmaakt van de unieke aanduiding van een object"@nl ;
            sh:maxCount 1 ;
            sh:name "identificerend"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/identificerend> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:name "id"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/id> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 40 ;
            sh:name "stereotype"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/stereotype> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Aanduiding dat gegeven afleidbaar is uit andere attribuut- en/of relatiesoorten."@nl ;
            sh:maxCount 1 ;
            sh:name "indicatieAfleidbaar"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/indicatieafleidbaar> ],
        [ sh:datatype xsd:string ;
            sh:description "De beschrijving van de betekenis van het objecttype zoals gespecificeerd in de catalogus van de desbetreffende (basis)registratie of informatiemodel."@nl ;
            sh:maxCount 1 ;
            sh:name "definitie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/definitie> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "toelichting"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/toelichting> ],
        [ sh:datatype xsd:string ;
            sh:description "<i>Domein is zelf geen metadata aspect. Onder het kopje ‘domein’ vallen een aantal metadata aspecten die gelden voor een waarde, oftewel de eisen waaraan een waarde van een attribuutsoort moet voldoen.</i>"@nl ;
            sh:maxCount 1 ;
            sh:maxLength 80 ;
            sh:name "domein"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/domein> ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:name "mogelijkGeenWaarde"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/mogelijkgeenwaarde> ],
        [ sh:datatype xsd:string ;
            sh:description """De aanduiding van de lengte van een gegeven. Getallen kunnen altijd positief of negatief zijn.
<i>Bijvoorbeeld:</i>
<i>‘1’ als de lengte exact 1 is;</i>
<i>‘1..2’ als de lengte 1 tot en met 2 lang kan zijn; '‘1,2’ voor Decimale getallen met 1 cijfer voor de komma en 2 erna. </i>Dit is van -9,99 tot +9,99;"""@nl ;
            sh:maxCount 1 ;
            sh:maxLength 40 ;
            sh:name "lengte"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/lengte> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicatie of de materiële historie van de attribuutsoort te bevragen is. Materiële historie geeft aan wanneer een verandering is opgetreden in de werkelijkheid die heeft geleid tot verandering van de attribuutwaarde."@nl ;
            sh:maxCount 1 ;
            sh:name "indicatieMaterieleHistorie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/attribuutsoort/indicatiematerielehistorie> ],
        [ sh:class <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/datatype> ;
            sh:maxCount 1 ;
