            sh:name "gemeente"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/volkshuisvesting-leefomgeving-en-stedelijke-vernieuwing/beheer-openbare-ruimte/basis-imbor/imbor/beheerobject/gemeente> ],
