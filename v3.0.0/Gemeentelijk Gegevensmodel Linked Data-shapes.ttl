<https://lod.gemeentelijkgegevensmodel.nl/shapes/sociaal-domein/schulden/schuldhulpverlening/aanmelding> a sh:NodeShape ;
    rdfs:label "Aanmelding"@nl ;
    dcterms:identifier "EAID_1CE06538_3F4A_45ac_AE86_30A4250D3608" ;
    sh:property [ sh:datatype xsd:date ;
            sh:description "Datum waarop een persoon met een hulpvraag komt rondom (dreigende) schulden, en het eerste contact met schuldhulpverlening is geweest. Dit kan een persoonlijke, schriftelijke, digitale of telefonische vraag zijn."@nl ;
            sh:maxCount 1 ;
            sh:name "startdatum"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/schuldhulpverlening/aanmelding/startdatum> ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:name "einddatum"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/schuldhulpverlening/aanmelding/einddatum> ],
        [ sh:class <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/schuldhulpverlening/intake> ;
            sh:maxCount 1 ;
            sh:name "resulteert in"@nl ;
            sh:nodeKind sh:IRI ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/schuldhulpverlening/aanmelding/resulteert-in> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Is er sprake van een crisisinterventie? Indicator crisisinterventie. "Het afwenden van een crisis- of dreigende situatie om zo de mogelijkheid te cre&#235;ren om de klant te helpen via de reguliere schuldhulpverlening.
Volgens de Wgs gaat het in elk geval om de volgende situaties:
■ gedwongen woningontruiming;
■ be&#235;indiging van de levering van gas, water, elektriciteit of stadsverwarming;
■ opzegging of ontbinding van de zorgverzekering.
Gemeenten kunnen extra situaties toevoegen aan hun crisisprotocol, zoals:
■ aangekondigde boedelverkoop of verkoop van de eigen woning;
■ loon- of bankbeslag;
■ een faillissementsaanvraag.
En voor ondernemers:
■ beslag op (on)roerende zaken dat het voortbestaan van de onderneming bedreigt;
■ opzegging van het bankkrediet.\""""@nl ;
            sh:maxCount 1 ;
            sh:name "crisisinterventie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/schuldhulpverlening/aanmelding/crisisinterventie> ] ;
    sh:targetClass <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/schuldhulpverlening/aanmelding> .

