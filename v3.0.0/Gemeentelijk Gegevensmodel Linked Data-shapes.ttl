            sh:description "De fase van de bouw, verbouw of sloop waarin het betreffende PAND zich bevindt"@nl ;
            sh:in ( <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/nieuwbouwvergunning-verleend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/nieuwbouw-gestart> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/nieuwbouw-gereed> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/verbouwvergunning-verleend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/verbouw-gestart> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/verbouw-gereed> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/sloopvergunning-verleend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/sloop-gestart> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/sloop-gereed> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/nieuwbouwvergunning-ingetrokken> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/verbouwvergunning-ingetrokken> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/sloopvergunning-ingetrokken> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/onbekend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statusvoortgangbouw/leeg> ) ;
