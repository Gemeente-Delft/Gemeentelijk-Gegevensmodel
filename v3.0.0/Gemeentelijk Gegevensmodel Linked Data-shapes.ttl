        [ sh:class <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand> ;
            sh:description """De fase van de levenscyclus van een PAND, waarin het betreffende PAND zich bevindt.
<ul>
	<li>Bouwvergunning verleend</li>
	<li>Niet gerealiseerd pand</li>
	<li>Bouw gestart</li>
	<li>Pand in gebruik (niet ingemeten)</li>
	<li>Pand in gebruik</li>
	<li>Sloopvergunning verleend</li>
	<li>Pand gesloopt</li>
	<li>Pand buiten gebruik</li>
	<li>Verbouwing pand</li>
	<li>Pand ten onrechte opgevoerd</li>
</ul>"""@nl ;
            sh:in ( <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/bouwvergunning-verleend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/niet-gerealiseerd-pand> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/bouw-gestart> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/pand-in-gebruik-niet-ingemeten> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/pand-in-gebruik> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/sloopvergunning-verleend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/pand-gesloopt> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/pand-buiten-gebruik> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/verbouwing-pand> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/pand-ten-onrechte-opgevoerd> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/bouwaanvraag-ontvangen> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/onbekend> <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand/leeg> ) ;
