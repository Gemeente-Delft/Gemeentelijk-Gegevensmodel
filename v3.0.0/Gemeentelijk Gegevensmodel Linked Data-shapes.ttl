            sh:name "datumOpname"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/datumopname> ],
        [ sh:datatype xsd:string ;
            sh:description """Het gerelateerde objecttype (de target) waarvan het objecttype, die de eigenaar is van deze relatie (de source), kennis heeft.
Alle relaties zijn altijd gericht van het objecttype (source) naar het gerelateerde objecttype (target)."""@nl ;
            sh:maxCount 1 ;
            sh:maxLength 40 ;
            sh:name "unidirectioneel"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/unidirectioneel> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "toelichting"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/toelichting> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:maxLength 80 ;
            sh:name "naam"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/naam> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Indicatie of de materiële historie van de attribuutsoort te bevragen is. Materiële historie geeft aan wanneer een verandering is opgetreden in de werkelijkheid die heeft geleid tot verandering van de attribuutwaarde."@nl ;
            sh:maxCount 1 ;
            sh:name "indicatieMaterieleHistorie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/indicatiematerielehistorie> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:name "ea_guid"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/ea-guid> ],
        [ sh:datatype xsd:boolean ;
            sh:description "Aanduiding dat gegeven afleidbaar is uit andere attribuut- en/of relatiesoorten."@nl ;
            sh:maxCount 1 ;
            sh:name "indicatieAfleidbaar"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/indicatieafleidbaar> ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:name "id"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Deze indicatie geeft aan hoeveel keer waarden van deze attribuutsoort kunnen voorkomen bij een object van het betreffende objecttype, of bij het betreffende gegevensgroeptype:
0..1: is soms niet beschikbaar
1 : is altijd beschikbaar
0..*: is niet altijd beschikbaar, kan
meerdere malen voorkomen 1..*: is altijd beschikbaar, kan
meerdere malen voorkomen
Indien een attribuutsoort deel uit maakt van een gegevensgroeptype, dan wordt de kardinaliteit vermeld van het attribuutsoort binnen het gegevensgroeptype. Voor de uiteindelijke kardinaliteit van hoe vaak een gegeven voorkomt bij het object moet rekening gehouden worden met de kardinaliteit van de gegevensgroep en met de kardinaliteit van de attribuutsoort."""@nl ;
            sh:maxCount 1 ;
            sh:maxLength 40 ;
            sh:name "kardinaliteit"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/kardinaliteit> ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:name "mogelijkGeenWaarde"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/mogelijkgeenwaarde> ],
        [ sh:datatype xsd:string ;
            sh:description "De beschrijving van de betekenis van het objecttype zoals gespecificeerd in de catalogus van de desbetreffende (basis)registratie of informatiemodel."@nl ;
            sh:maxCount 1 ;
            sh:name "definitie"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/definitie> ],
        [ sh:datatype xsd:string ;
            sh:description "De registratie in wiens catalogus het objecttype is gespecificeerd (oftewel de registratie waar het objecttype deel van uitmaakt). Deze specificatie is toegevoegd omdat het wel duidelijk moet zijn in welke (basis)registratie of informatiemodel het objecttype voorkomt (indien van toepassing)."@nl ;
            sh:maxCount 1 ;
            sh:maxLength 80 ;
            sh:name "herkomst"@nl ;
            sh:path <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort/herkomst> ] ;
    sh:targetClass <https://lod.gemeentelijkgegevensmodel.nl/interne-organisatie/ict/relatiesoort> .

