<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/interventie> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Interventie"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/interventie/beslisdatum>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/interventie/ingangsdatum>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/interventie/interventietype> ;
    mim:definitie "De daadwerkelijke interventie, die wordt ondernomen naar aanleiding van een interventieverzoek."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/interventie"^^xsd:anyURI ;
