<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/loonbeslagafspraak> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Loonbeslagafspraak"@nl ;
    mim:definitie "Een loonbeslagafspraak is een aflossingsafspraak.Tevens is het een afspraak tussen twee partijen (organisaties) om voor het aflossen van vorderingen. Hierbij zal de ene partij - de werkgever van de debiteur - een afgesproken bedrag in houden op het loon van de debiteur en het ingehouden bedrag overmaken naar crediteur.Aangezien Loonbeslag een Inkomstencomponent is (zie het inkomstenmodel) ligt er een impliciete relatie tussen de Loonbeslagafspraak en het Loonbeslag."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/loonbeslagafspraak"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Loonbeslagafspraak"@nl ;
    dcterms:identifier "EAID_1a6b9a31_c4c7_4b46_92ef_0dd7e31613ed" ;
    rdfs:comment "Een loonbeslagafspraak is een aflossingsafspraak.Tevens is het een afspraak tussen twee partijen (organisaties) om voor het aflossen van vorderingen. Hierbij zal de ene partij - de werkgever van de debiteur - een afgesproken bedrag in houden op het loon van de debiteur en het ingehouden bedrag overmaken naar crediteur.Aangezien Loonbeslag een Inkomstencomponent is (zie het inkomstenmodel) ligt er een impliciete relatie tussen de Loonbeslagafspraak en het Loonbeslag."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/> ;
    rdfs:subClassOf <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/aflossingsafspraak> .

