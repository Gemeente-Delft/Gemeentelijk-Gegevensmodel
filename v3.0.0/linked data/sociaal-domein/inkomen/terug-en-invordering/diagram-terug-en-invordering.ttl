    mim:definitie "Na nader inzicht corrigeren van het te vorderen bedrag met een zeker bedrag. Correcties worden geadministreerd onder de vordering."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/correctie"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Correctie"@nl ;
    dcterms:identifier "EAID_1B73F18A_888E_945B_4A20_26E8FA774D4C" ;
    rdfs:comment "Na nader inzicht corrigeren van het te vorderen bedrag met een zeker bedrag. Correcties worden geadministreerd onder de vordering."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/terug-en-invordering/> .

