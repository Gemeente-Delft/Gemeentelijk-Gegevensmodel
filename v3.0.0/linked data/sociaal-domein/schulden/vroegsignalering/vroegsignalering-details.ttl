    rdfs:label "Geen reactie na eerder contact"@nl ;
    mim:code "GR" ;
    mim:definitie """Er is in eerste instantie contact is met de inwoner. Vervolgens lukt het niet meer om contact te krijgen. 
Bijvoorbeeld: de inwoner komt niet op de afspraak, is telefonisch onbereikbaar of reageert niet op e-mails of WhatsApp-berichten."""@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat/geen-reactie-na-eerder-contact"^^xsd:anyURI ;
