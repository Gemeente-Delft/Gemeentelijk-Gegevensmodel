<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat/niet-opgepakt-herhaalde-melding> a mim:Enumeratiewaarde,
        skos:Concept,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat> ;
    rdfs:label "Niet opgepakt: herhaalde melding"@nl ;
    mim:code "NH" ;
    mim:definitie """Een signaal dat niet wordt opgepakt, omdat er recent al een signaal is ontvangen en opgepakt over dezelfde betalingsachterstand van dezelfde vastelastenpartner. De betalingsachterstand is niet hoger geworden. Als de achterstand wel hoger is geworden, moet deze wel worden opgepakt.
Dit eindresultaat wordt teruggekoppeld aan de vastelastenpartner."""@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat/niet-opgepakt-herhaalde-melding"^^xsd:anyURI ;
