    mim:datumOpname "2008-05-01"^^xsd:date ;
    mim:definitie "De nieuwe GEMEENTE waarin de GEMEENTE bij zijn opheffing c.q. na herindeling is overgegaan."@nl ;
    mim:doel <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/gemeente> ;
    mim:heeftTijdlijnGeldigheid false ;
