    mim:herkomstDefinitie "KING o.b.v. BAG" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/overiggebouwdobject/overiggebouwdobjectidentificatie"^^xsd:anyURI ;
