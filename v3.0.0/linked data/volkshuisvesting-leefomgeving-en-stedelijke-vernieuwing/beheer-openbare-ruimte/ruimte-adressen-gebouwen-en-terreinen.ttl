    mim:indicatieFormeleHistorie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:kardinaliteit "1..1" ;
    mim:mogelijkGeenWaarde false ;
    mim:naam "overigGebouwdObjectIdentificatie"@nl ;
    mim:patroon """Combinatie van de viercijferige 'gemeentecode' (volgens BRP stamtabel A.5.4 Gemeente), de tweecijferige 'objecttypecode' en een voor het betreffende objecttype binnen een gemeente uniek tiencijferig 'objectvolgnummer'.

Voor de gevallen dat het gebouwd object geen verblijfsobject maar een overig bouwwerk betreft, is de volgende domeinwaarde toegevoegd:
91 overig bouwwerk""" ;
    mim:type <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/complex-datatype/bagobjectnummering> ;
    dcterms:identifier "EAID_073F4BB6_B410_4595_B6E2_A9CDAEC9FD52" ;
    rdfs:comment "De unieke identificatie van een OVERIG GEBOUWD OBJECT"@nl ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/overiggebouwdobject> ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/> ;
    rdfs:range <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/complex-datatype/bagobjectnummering> .

