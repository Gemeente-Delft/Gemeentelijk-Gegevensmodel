<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/huisnummerrange-even-en-oneven-nummers> a mim:Attribuutsoort,
        owl:DatatypeProperty ;
    rdfs:label "Huisnummerrange even en oneven nummers"@nl ;
    mim:authentiek mim:Authentiek ;
    mim:datumOpname "2007-04-09"^^xsd:date ;
    mim:definitie "Het laagste en het hoogste huisnummer van de objecten waaraan NUMMERAANDUIDINGen zijn toegekend die gerelateerd zijn aan de OPENBARE RUIMTE in die gevallen dat aan één of beide zijden van de OPENBARE RUIMTE zowel even als oneven huisnummers voorkomen dan wel dat even en/of oneven huisnummers aan beide zijden van de openbare ruimte voorkomen."@nl ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:herkomst "KING" ;
    mim:herkomstDefinitie "KING" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/huisnummerrange-even-en-oneven-nummers"^^xsd:anyURI ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:indicatieFormeleHistorie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:kardinaliteit "1..1" ;
    mim:mogelijkGeenWaarde false ;
    mim:naam "Huisnummerrange even en oneven nummers"@nl ;
    mim:patroon """huisnummers van nummeraanduidingen die gerelateerd zijn aan de openbare ruimte
Format: NNNNN-NNNNN""" ;
    mim:toelichting "Veelal liggen de even en de oneven huisnummers telkens aan één van beide zijden van de openbare ruimte. Het komt evenwel voor dat deze aan beide zijden liggen of dat er aan één zijde zowel even als oneven huisnummers voorkomen. Dit gegeven voorziet in de twee laatstgenoemde situaties."@nl ;
    mim:type mim:CharacterString ;
    dcterms:identifier "EAID_5866E686_87DC_45eb_B3B5_ADFD4F4D16E1" ;
    rdfs:comment "Het laagste en het hoogste huisnummer van de objecten waaraan NUMMERAANDUIDINGen zijn toegekend die gerelateerd zijn aan de OPENBARE RUIMTE in die gevallen dat aan één of beide zijden van de OPENBARE RUIMTE zowel even als oneven huisnummers voorkomen dan wel dat even en/of oneven huisnummers aan beide zijden van de openbare ruimte voorkomen."@nl ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte> ;
