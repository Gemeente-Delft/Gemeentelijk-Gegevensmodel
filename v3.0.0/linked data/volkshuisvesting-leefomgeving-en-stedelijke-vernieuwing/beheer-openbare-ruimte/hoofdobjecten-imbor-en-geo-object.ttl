<https://lod.gemeentelijkgegevensmodel.nl/volkshuisvesting-leefomgeving-en-stedelijke-vernieuwing/beheer-openbare-ruimte/basis-imbor/imbor/vegetatieobject/typestandplaats> a mim:Attribuutsoort,
        owl:ObjectProperty ;
    rdfs:label "typeStandplaats"@nl ;
    mim:definitie "Met de standplaats van een object wordt letterlijk bedoeld de plaats waar het object staat. Bij een boom wordt hiermee bedoeld de plaats van de boom en het bijbehorende wortelgestel. Als synoniem wordt vaak groeiplaats gebruikt. Voor het IMBOR wordt de fysieke verschijningsvorm als indeling gebruikt, conform de indeling in typen groen en typen verharding. Dit geeft voor de boombeheerder een aanduiding van de groeiomstandigheden."@nl ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/volkshuisvesting-leefomgeving-en-stedelijke-vernieuwing/beheer-openbare-ruimte/basis-imbor/imbor/vegetatieobject/typestandplaats"^^xsd:anyURI ;
