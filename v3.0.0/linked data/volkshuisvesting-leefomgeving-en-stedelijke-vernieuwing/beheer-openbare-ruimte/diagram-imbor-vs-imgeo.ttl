        owl:DatatypeProperty ;
    rdfs:label "geometrieInrichtingselement"@nl ;
    mim:datumOpname "2007-04-09"^^xsd:date ;
    mim:definitie "De geometrische representatie van een inrichtingselement."@nl ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:herkomst "IMGeo" ;
    mim:herkomstDefinitie "IMGeo" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/inrichtingselement/geometrieinrichtingselement"^^xsd:anyURI ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:indicatieFormeleHistorie true ;
    mim:indicatieMaterieleHistorie false ;
    mim:kardinaliteit "1..1" ;
    mim:mogelijkGeenWaarde false ;
    mim:naam "geometrieInrichtingselement"@nl ;
    mim:patroon """Aanduiding van het type geometrie (Punt, Lijn of Vlak) gevolgd door coördinatenparen binnen de in Nederland gelegen waarden van het RD-stelsel.

Zie ook regels attribuutsoort.""" ;
    mim:type <https://lod.gemeentelijkgegevensmodel.nl/datatypen/gm-surface> ;
    dcterms:identifier "EAID_426FE3C3_423C_44d3_AEE0_00270B6AC471" ;
    rdfs:comment "De geometrische representatie van een inrichtingselement."@nl ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/inrichtingselement> ;
