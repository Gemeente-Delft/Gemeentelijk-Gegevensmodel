    rdfs:range geo:wktLiteral .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/inrichtingselement/identificatieinrichtingselement> a mim:Attribuutsoort,
        owl:DatatypeProperty ;
    rdfs:label "identificatieInrichtingselement"@nl ;
    mim:datumOpname "2007-04-09"^^xsd:date ;
    mim:definitie "Een unieke identificatie voor een inrichtingselement."@nl ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:herkomst "BGT" ;
    mim:herkomstDefinitie "BGT" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/inrichtingselement/identificatieinrichtingselement"^^xsd:anyURI ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:indicatieFormeleHistorie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:kardinaliteit "1..1" ;
    mim:mogelijkGeenWaarde false ;
    mim:naam "identificatieInrichtingselement"@nl ;
    mim:patroon """NL.IMGEO.xxxx. Het 1e deel is de landcode, het 2e deel is de code voor het sectormodel. Het derde deel is de combinatie van de (viercijferige) gemeentecode (volgens BRP stamtabel A.5.4 Gemeente), de tweecijferige code voor het type geoobject (01) en een voor het betreffende objecttype binnen een gemeente unieke tiencijferige objectvolgnummer.

Identificatie is maximaal 25 alfanumerieke tekens lang.Zie voor verdere specificaties datatype NEN3610ID.""" ;
    mim:toelichting """In het IMGeo betreft dit de identificatie van het overeenkomstige geo-object. 
Voor de identificatie worden de richtlijnen van NEN 3610 gehanteerd."""@nl ;
    mim:type mim:CharacterString ;
    dcterms:identifier "EAID_C866C4A0_D914_44fa_BF7D_AF201C5B2C86" ;
    rdfs:comment "Een unieke identificatie voor een inrichtingselement."@nl ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/inrichtingselement> ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/> ;
    rdfs:range xsd:string .

