    mim:indicatieMaterieleHistorie false ;
    mim:kardinaliteit "1..1" ;
    mim:mogelijkGeenWaarde true ;
    mim:naam "takvrijeStam"@nl ;
    mim:type <https://lod.gemeentelijkgegevensmodel.nl/volkshuisvesting-leefomgeving-en-stedelijke-vernieuwing/beheer-openbare-ruimte/basis-imbor/enumeratiesoort/enum-takvrijestam> ;
