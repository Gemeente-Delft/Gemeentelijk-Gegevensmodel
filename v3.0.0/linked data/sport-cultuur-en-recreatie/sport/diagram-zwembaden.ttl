<https://lod.gemeentelijkgegevensmodel.nl/volkshuisvesting-leefomgeving-en-stedelijke-vernieuwing/beheer-openbare-ruimte/imbor-2025/zwembadgebouw> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Zwembadgebouw"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/volkshuisvesting-leefomgeving-en-stedelijke-vernieuwing/beheer-openbare-ruimte/imbor-2025/zwembadgebouw/naam> ;
    mim:datumOpname "2026-11-11"^^xsd:date ;
    mim:definitie "Een zwembadgebouw is een gebouw dat is ontworpen en gebouwd om een of meer zwembaden te huisvesten, inclusief voorzieningen voor zwemmers en toeschouwers, en andere ondersteunende functies. Het kan een openbaar of particulier zwembad zijn en omvat vaak kleedkamers, douches, sanitaire voorzieningen, een ontvangstruimte en technische ruimtes voor de waterbehandeling en verwarming."@nl ;
    mim:herkomst "IMBOR 2025 (CROW)" ;
    mim:herkomstDefinitie "IMBOR 2025 (CROW)" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/volkshuisvesting-leefomgeving-en-stedelijke-vernieuwing/beheer-openbare-ruimte/imbor-2025/zwembadgebouw"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Zwembadgebouw"@nl ;
    mim:toelichting "Dit objecttype komt uit IMBOR 2025 (CROW) en is voor het proposal Zwembaden overgenomen omdat IMBOR 2025 nog niet in het GGM is opgenomen. Bij de opname van IMBOR 2025 moet dit objecttype worden vervangen door het objecttype uit IMBOR 2025. In IMBOR heeft Zwembadgebouw geen eigen attributen en is het samengesteld uit Constructie, FysiekObject, Gebouw, Geo-object, Object en ReëelObject."@nl ;
    dcterms:identifier "EAID_42A61A85_526A_4813_96CA_7922FD6DD049" ;
    rdfs:comment "Een zwembadgebouw is een gebouw dat is ontworpen en gebouwd om een of meer zwembaden te huisvesten, inclusief voorzieningen voor zwemmers en toeschouwers, en andere ondersteunende functies. Het kan een openbaar of particulier zwembad zijn en omvat vaak kleedkamers, douches, sanitaire voorzieningen, een ontvangstruimte en technische ruimtes voor de waterbehandeling en verwarming."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/volkshuisvesting-leefomgeving-en-stedelijke-vernieuwing/beheer-openbare-ruimte/imbor-2025/> .

