<https://lod.gemeentelijkgegevensmodel.nl/veiligheid_en_vergunningen/heffingsverordening> a owl:Class ;
    rdfs:label "Heffingsverordening"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een *heffingsverordening* is een door de gemeenteraad vastgestelde verordening die de **heffing en invordering van gemeentelijke belastingen en rechten** regelt, zoals afvalstoffenheffing, precariobelasting of marktgelden."@nl ;
    dct:identifier "C29CCD49-04E2-44b4-A6B0-AD8B10552628" .

