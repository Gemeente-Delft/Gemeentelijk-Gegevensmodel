<https://lod.gemeentelijkgegevensmodel.nl/veiligheid_en_vergunningen/vomaanvraagofmelding> a owl:Class ;
    rdfs:label "VOMAanvraagOfMelding"@nl ;
    ggm:objectType "Class" ;
    dct:description "VOM staat voor Vergunning, Ontheffing of Melding. Het betreft hier een melding of een aanvraag voor een vergunning of een ontheffing."@nl ;
