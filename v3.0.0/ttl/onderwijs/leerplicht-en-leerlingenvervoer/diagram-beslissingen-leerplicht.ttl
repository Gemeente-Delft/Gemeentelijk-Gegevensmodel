        owl:Class ;
    rdfs:label "HALT-verwijzing"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/onderwijs/leerplicht-en-leerlingenvervoer/halt-verwijzing/afdoening>,
        <https://lod.gemeentelijkgegevensmodel.nl/onderwijs/leerplicht-en-leerlingenvervoer/halt-verwijzing/datummutatie>,
