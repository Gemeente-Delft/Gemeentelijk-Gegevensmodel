<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/archief/kern-rsgb/benoemdobject> a mim:Objecttype,
        owl:Class ;
    rdfs:label "BenoemdObject"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/archief/kern-rsgb/benoemdobject/datumbegingeldigheid>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/archief/kern-rsgb/benoemdobject/datumeindegeldigheid>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/archief/kern-rsgb/benoemdobject/geometriepunt>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/archief/kern-rsgb/benoemdobject/geometrievlak>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/archief/kern-rsgb/benoemdobject/identificatie> ;
    mim:datumOpname "2016-05-01"^^xsd:date ;
    mim:definitie "Een GEBOUWD OBJECT of een BENOEMD TERREIN"@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/archief/kern-rsgb/benoemdobject"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "BenoemdObject"@nl ;
    mim:toelichting "Het objecttype betreft alle objecten die van een, al dan niet authentieke, nummeraanduiding voorzien worden. Anders gezegd, alle objecten ‘met een adres’. Het is aldus de generalisatie van zowel GEBOUWD OBJECT en BENOEMD TERREIN en daarmee tevens van alle specialisaties van deze objecttypen, met name VERBLIJFSOBJECT, OVERIG BOUWWERK, STANDPLAATS, LIGPLAATS en OVERIG BENOEMD TERREIN."@nl ;
