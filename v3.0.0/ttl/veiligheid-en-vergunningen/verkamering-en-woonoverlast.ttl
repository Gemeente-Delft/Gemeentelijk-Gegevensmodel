<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/onbestemd-adres> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Onbestemd Adres"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/onbestemd-adres/huisletter>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/onbestemd-adres/huisnummer>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/onbestemd-adres/huisnummertoevoeging>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/onbestemd-adres/postcode>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/onbestemd-adres/straatnaam> ;
    mim:definitie "*Onbestemd Adres* is een adres-aanduiding die officieel door een bevoegde gemeentelijke instantie is vastgelegd, maar waarbij niet kan worden vastgesteld dat het een regulier woon- of verblijfsadres betreft."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/onbestemd-adres"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Onbestemd Adres"@nl ;
    mim:toelichting "In gemeentelijke en basisregistratiecontexten (zoals in het RSGB/GBI-model en de BAG/BRP-administraties) wordt een *Onbestemd Adres* gebruikt voor adressen die wel geregistreerd zijn, maar **niet eenduidig kunnen worden gekoppeld aan een woonadres of een ander specifiek verblijf** van een persoon of object. Dit kan bijvoorbeeld voorkomen bij adressen waar geen vaste bewoning plaatsvindt, waar onduidelijkheid is over de verblijfstatus of bij nummers die in de administratie bestaan maar niet leiden tot een traceerbare bewoning. Het betreft een **officiële adresaanduiding** zoals opgenomen door het bevoegde gemeentelijke orgaan binnen het informatiemodel, zonder dat het direct een vaste woon- of verblijfsfunctie heeft."@nl ;
    dcterms:identifier "EAID_75E93FC5_3EF8_40b6_B170_ED5A2C36B354" ;
    rdfs:comment "*Onbestemd Adres* is een adres-aanduiding die officieel door een bevoegde gemeentelijke instantie is vastgelegd, maar waarbij niet kan worden vastgesteld dat het een regulier woon- of verblijfsadres betreft."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/> ;
    rdfs:subClassOf <https://lod.gemeentelijkgegevensmodel.nl/kern/rgbzplus/rgbz/kern-rgbz/object> .

<https://lod.gemeentelijkgegevensmodel.nl/veiligheid-en-vergunningen/vth/activiteit-omgevingswet> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Activiteit Omgevingswet"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/veiligheid-en-vergunningen/vth/activiteit-omgevingswet/omschrijving> ;
    mim:definitie "Ieder menselijk handelen waarbij, of ieder menselijk nalaten waardoor een verandering of effect in de (fysieke) leefomgeving wordt of kan worden bewerkstelligd."@nl ;
