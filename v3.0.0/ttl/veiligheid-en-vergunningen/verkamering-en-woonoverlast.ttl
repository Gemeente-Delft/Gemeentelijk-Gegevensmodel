<https://lod.gemeentelijkgegevensmodel.nl/veiligheid-en-vergunningen/vth/heffingsverordening> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Heffingsverordening"@nl ;
    mim:definitie "Een *heffingsverordening* is een door de gemeenteraad vastgestelde verordening die de **heffing en invordering van gemeentelijke belastingen en rechten** regelt, zoals afvalstoffenheffing, precariobelasting of marktgelden."@nl ;
    mim:herkomstDefinitie "https://www.rijksoverheid.nl/onderwerpen/gemeenten/vraag-en-antwoord/welke-belastingen-heft-de-gemeente" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/veiligheid-en-vergunningen/vth/heffingsverordening"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Heffingsverordening"@nl ;
    mim:toelichting "Gemeenten mogen alleen heffingen vaststellen binnen de kaders die de wet hen geeft. Een heffingsverordening bevat de regels over **welke belastingen of rechten worden geheven, wie belastingplichtig is, wat de maatstaf en tarieven zijn, en hoe invordering plaatsvindt**. Dit is de lokale juridische basis voor het innen van gemeentelijke heffingen waarvoor de gemeenteraad een verordening opstelt."@nl ;
    dcterms:identifier "EAID_C29CCD49_04E2_44b4_A6B0_AD8B10552628" ;
    rdfs:comment "Een *heffingsverordening* is een door de gemeenteraad vastgestelde verordening die de **heffing en invordering van gemeentelijke belastingen en rechten** regelt, zoals afvalstoffenheffing, precariobelasting of marktgelden."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/veiligheid-en-vergunningen/vth/> .

