rivier."""@nl ;
    skos:inScheme <https://lod.gemeentelijkgegevensmodel.nl/enumeraties/typeringwaterplus> ;
    skos:prefLabel "rivier"@nl ;
    skos:topConceptOf <https://lod.gemeentelijkgegevensmodel.nl/enumeraties/typeringwaterplus> .

