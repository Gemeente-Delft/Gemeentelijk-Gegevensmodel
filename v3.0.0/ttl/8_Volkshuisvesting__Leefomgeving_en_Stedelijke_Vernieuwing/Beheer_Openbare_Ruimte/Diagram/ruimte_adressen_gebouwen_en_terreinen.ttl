<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb_model/overiggebouwdobject> a owl:Class ;
    rdfs:label "OverigGebouwdObject"@nl ;
    ggm:objectType "Class" ;
    dct:description "De kleinste eenheid van gebruik, geen verblijfsobject zijnde, binnen een bij de totstandkoming functioneel en bouwkundig constructief zelfstandige eenheid die direct en duurzaam met de aarde is verbonden."@nl ;
    dct:identifier "7CDF37D9-26D7-46a5-9CF3-392601BDCECA" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb_model/overigbenoemdterrein> a owl:Class ;
    rdfs:label "OverigBenoemdTerrein"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een door het bevoegde gemeentelijke orgaan als zodanig aangewezen onbebouwd terrein of een gedeelte daarvan, geen standplaats of gedeelte van een ligplaats zijnde, dat bestemd is voor het gedurende langere tijd verrichten van een maatschappelijke activiteit."@nl ;
    dct:identifier "CFA3D54E-C8E0-4559-9475-29D31AF2DECD" .

