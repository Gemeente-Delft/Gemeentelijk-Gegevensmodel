<https://lod.gemeentelijkgegevensmodel.nl/volkshuisvesting_leefomgeving_en_stedelijke_vernieuwing/beheer_openbare_ruimte/geo_object> a owl:Class ;
    rdfs:label "Geo-Object"@nl ;
    ggm:objectType "Class" ;
    dct:description "Abstractie van een fenomeen in de werkelijkheid, dat direct of indirect is geassocieerd met een locatie relatief ten opzichte van de aarde. [NEN 3610:2011]"@nl ;
    dct:identifier "05B355EF-39EA-4bfb-B1F3-AB31841C986E" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/pand> a owl:Class ;
    rdfs:label "Pand"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een pand is een kleinste bij de totstandkoming functioneel en bouwkundig-constructief zelfstandige eenheid die direct en duurzaam met de aarde is verbonden en betreedbaar en afsluitbaar is. Beschrijving: Een zelfstandig bouwwerk, zowel zelfstandig in de manier hoe het is gebouwd als waarvoor het is bedoeld om te gebruiken. Een pand voldoet ook aan de volgende eisen: een pand is direct en voor lange tijd met de aarde verbonden (een pand is niet makkelijk te verplaatsen) en een pand kun je binnengaan en afsluiten. Een eenheid kan alleen een pand zijn als het voldoet aan alle eisen uit de Catalogus BAG 2018."@nl ;
    dct:identifier "11595AD8-CE67-40dd-BDA9-489DC7D244ED" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb_model/overigbouwwerk> a owl:Class ;
    rdfs:label "OverigBouwwerk"@nl ;
    ggm:objectType "Class" ;
    dct:description "Met de aarde verbonden duurzaam bouwwerk, dat niet valt onder de definities van een pand of kunstwerk."@nl ;
    dct:identifier "1DA7BC25-CF02-4161-B9A2-DE0BE27C5254" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb_model/overbruggingsdeel> a owl:Class ;
    rdfs:label "Overbruggingsdeel"@nl ;
    ggm:objectType "Class" ;
    dct:description "Onderdeel van een beweegbare of vaste verbinding tussen twee punten, die door water, een weg of anderszins gescheiden zijn, dat essentieel is voor de constructie."@nl ;
    dct:identifier "2E45A5F3-A685-48c5-98D4-794BE382891E" .

