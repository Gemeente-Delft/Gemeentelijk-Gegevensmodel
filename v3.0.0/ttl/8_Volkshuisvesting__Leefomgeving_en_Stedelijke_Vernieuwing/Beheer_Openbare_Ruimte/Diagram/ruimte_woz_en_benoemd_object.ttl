<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb_model/kadastraalperceel> a owl:Class ;
    rdfs:label "KadastraalPerceel"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een KADASTRALE ONROERENDE ZAAK dat een kadastraal geïdentificeerd en met kadastrale grenzen begrensd deel van het Nederlands grondgebied betreft (art. 1 lid 1 Kadasterwet)."@nl ;
    dct:identifier "172AFD36-B400-4660-BFAC-4BBC1077D666" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb_model/appartementsrecht> a owl:Class ;
    rdfs:label "Appartementsrecht"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een KADASTRALE ONROERENDE ZAAK dat een aandeel is in de goederen die in de splitsing zijn betrokken, dat de bevoegdheid omvat tot het uitsluitend gebruik van bepaalde gedeelten van het gebouw die blijkens hun inrichting bestemd zijn of worden om als afzonderlijk geheel te worden gebruikt (art. 5:106 lid 4 BW)."@nl ;
    dct:identifier "869E0A04-A663-4839-970D-7FB82DF6C317" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb_model/zakelijkrecht> a owl:Class ;
