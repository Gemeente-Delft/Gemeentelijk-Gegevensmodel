<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/generiek_jeugd_en_wmo/aom_aanvraagwmojeugd> a owl:Class ;
    rdfs:label "AOM_AanvraagWmoJeugd"@nl ;
    ggm:objectType "Class" ;
    dct:description "*AOM_AanvraagWmoJeugd* is een objecttype in het gegevensmodel voor Wmo en Jeugd dat een **aanvraagtraject voor ondersteuning onder de Wet maatschappelijke ondersteuning (Wmo) en/of Jeugdwet** representeert."@nl ;
    dct:identifier "BE7C28C6-0922-4c6a-A953-3D598D991AB5" .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/generiek_jeugd_en_wmo/aommeldingwmojeugd> a owl:Class ;
    rdfs:label "AOMMeldingWmoJeugd"@nl ;
    ggm:objectType "Class" ;
    dct:description "*AOMMeldingWMOJeugd* is een objecttype in het gemeentelijk gegevensmodel dat een **melding van een situatie of hulpvraag binnen het kader van de Wet maatschappelijke ondersteuning (Wmo) en/of Jeugdwet** representeert."@nl ;
    dct:identifier "0FA25A4F-DF7F-4feb-9460-19D054E874F8" .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/generiek_jeugd_en_wmo/beschikking> a owl:Class ;
    rdfs:label "Beschikking"@nl ;
    ggm:objectType "Class" ;
    dct:description "In het bestuursrecht: Een beslissing van een overheidsorgaan in een concreet geval, bijvoorbeeld het verlenen van een bouwvergunning. In het civiele recht: een rechterlijke uitspraak in een procedure die begint met een verzoekschrift."@nl ;
    dct:identifier "71D7E96D-641A-4b6a-A325-DED07C3B5836" .

