<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/sociaal_domein_generiek/client> a owl:Class ;
    rdfs:label "Client"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een ingeschreven persoon die gebruik maakt van producten en diensten van de gemeente."@nl ;
    dct:identifier "DAF09055-A5A6-4ff4-A158-21B20567B296" .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/inkomen/component> a owl:Class ;
    rdfs:label "Component"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een *inkomenscomponent* is een afzonderlijk onderdeel of bron van inkomen, zoals loon, winst uit onderneming, uitkeringen of andere inkomensbronnen, die samen het totale inkomen van een persoon of huishouden vormen."@nl ;
    dct:identifier "F4FD02F2-9FFA-4a35-BA32-B4CDE4002E7A" .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/inkomen/componentsoort> a owl:Class ;
    rdfs:label "ComponentSoort"@nl ;
    ggm:objectType "Class" ;
    dct:description "*ComponentSoort* is de classificatie of het type van een inkomenscomponent binnen een inkomen- of financiële administratie, waarmee wordt bepaald welke categorie of soort een specifieke component behoort."@nl ;
    dct:identifier "3372192D-4773-46b2-BDA5-C98B220F8954" .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/inkomen/inkomensvoorziening> a owl:Class ;
    rdfs:label "Inkomensvoorziening"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een regeling die zorg draag voor een inkomen confom de landelijke wetgeving"@nl ;
    dct:identifier "07784236-3AA6-45e5-8253-7D088C4020B0" .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/inkomen/inkomensvoorzieningsoort> a owl:Class ;
    rdfs:label "Inkomensvoorzieningsoort"@nl ;
    ggm:objectType "Class" ;
    dct:description "Typering van een inkomensvoorziening"@nl ;
    dct:identifier "AF18E7D3-279D-4323-B785-6C75B4701430" .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/inkomen/regeling> a owl:Class ;
    rdfs:label "Regeling"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een Regeling is gekoppeld aan een ingeschreven persoon (client) en beschrijft de specifieke afspraken of voorwaarden waaronder inkomensondersteuning wordt verleend. Een regeling heeft altijd een relatie met een RegelingSoort, die het type regeling specificeert."@nl ;
    dct:identifier "C25455F3-FEB0-4c6d-9AA4-3B027718BEE3" .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/inkomen/regelingsoort> a owl:Class ;
    rdfs:label "Regelingsoort"@nl ;
    ggm:objectType "Class" ;
    dct:description "Typologie van een regeling"@nl ;
    dct:identifier "14D3C960-5EF2-433c-8E1C-B493974280E2" .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/inkomen/uitkeringsrun> a owl:Class ;
    rdfs:label "UitkeringsRun"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een *UitkeringsRun* is een geautomatiseerde verwerking in een financieel of administratief systeem waarbij **een groep uitkeringen of betalingen tegelijk wordt berekend en uitgevoerd** als onderdeel van een periodieke batch-verwerking."@nl ;
    dct:identifier "F787184D-3AA8-4132-96C4-23A363C3C1B7" .

