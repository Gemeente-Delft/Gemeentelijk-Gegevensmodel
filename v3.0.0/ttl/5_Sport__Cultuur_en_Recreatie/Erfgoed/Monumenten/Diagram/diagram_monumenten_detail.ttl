<https://lod.gemeentelijkgegevensmodel.nl/sport_cultuur_en_recreatie/erfgoed/monumenten/bouwstijl> a owl:Class ;
    rdfs:label "Bouwstijl"@nl ;
    ggm:objectType "Class" ;
    dct:description "Trant van bouwen met bepaalde kenmerken in een bepaalde periode. In de betrokken tijdperken waren het geen levende voorstellingen; het zijn later geformuleerde (generaliserende) geschiedkundige constructies. Doelbewust komt deze tendens op sedert c. 1830. (Haslinghuis)"@nl ;
    dct:identifier "8C0888C9-7B2E-4fcb-AEFF-E1733875CDCA" .

