<https://lod.gemeentelijkgegevensmodel.nl/volksgezondheid_en_milieu/afval/prijsregel> a owl:Class ;
    rdfs:label "Prijsregel"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een *prijsregel* is een **regel die aangeeft hoe de prijs van een product, dienst of prestatie wordt vastgesteld of toegepast**, bijvoorbeeld binnen een declaratie- of tariefstructuur."@nl ;
    dct:identifier "E79C6C20-3D05-49fb-96ED-105B5CD0ABA5" .

