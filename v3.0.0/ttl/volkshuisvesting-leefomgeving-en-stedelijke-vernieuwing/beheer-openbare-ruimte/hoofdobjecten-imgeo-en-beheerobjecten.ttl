<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/pand/status> a mim:Attribuutsoort,
        owl:ObjectProperty ;
    rdfs:label "status"@nl ;
    mim:definitie """De fase van de levenscyclus van een PAND, waarin het betreffende PAND zich bevindt.
<ul>
	<li>Bouwvergunning verleend</li>
	<li>Niet gerealiseerd pand</li>
	<li>Bouw gestart</li>
	<li>Pand in gebruik (niet ingemeten)</li>
	<li>Pand in gebruik</li>
	<li>Sloopvergunning verleend</li>
	<li>Pand gesloopt</li>
	<li>Pand buiten gebruik</li>
	<li>Verbouwing pand</li>
	<li>Pand ten onrechte opgevoerd</li>
</ul>"""@nl ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/bag/pand/status"^^xsd:anyURI ;
