    mim:indicatieClassificerend false ;
    mim:indicatieFormeleHistorie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:kardinaliteit "1..1" ;
    mim:mogelijkGeenWaarde false ;
    mim:naam "status"@nl ;
    mim:type <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/statuspand> ;
    dcterms:identifier "EAID_E9E38009_52E2_47b4_8F70_C51240C72D0D" ;
    rdfs:comment """De fase van de levenscyclus van een PAND, waarin het betreffende PAND zich bevindt.
<ul>
	<li>Bouwvergunning verleend</li>
	<li>Niet gerealiseerd pand</li>
	<li>Bouw gestart</li>
	<li>Pand in gebruik (niet ingemeten)</li>
	<li>Pand in gebruik</li>
	<li>Sloopvergunning verleend</li>
	<li>Pand gesloopt</li>
	<li>Pand buiten gebruik</li>
	<li>Verbouwing pand</li>
	<li>Pand ten onrechte opgevoerd</li>
</ul>"""@nl ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/pand> ;
