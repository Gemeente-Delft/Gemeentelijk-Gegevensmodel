        owl:DatatypeProperty ;
    rdfs:label "takvrijeZonePrimair"@nl ;
    mim:definitie """De benodigde takvrije ruimte tussen de weg of het fietspad en de onderkant van de boomkroon (eindbeeld van de boom). Als aan beide zijden van de boom een weg en een fietspad ligt, wordt de takvrije ruimte boven de weg aangeduid met primair, en de takvrijke ruimte boven het fietspad met secundair.
Eenheid: m
Toelichting: Takvrije zone: vrije ruimte ten behoeve van verkeer of andere omgevingsfactoren."""@nl ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
