    rdfs:label "takvrijeStam"@nl ;
    mim:definitie """De benodigde takvrije stam in het eindbeeld, gemeten vanaf maaiveld tot aan de onderste gesteltak.
Eenheid: m
Toelichting: Takvrije stam: gedeelte van de stam, gemeten vanaf maaiveld tot aan eerste gesteltak. Eindbeeld: vorm van een boom in volgroeide staat, omschreven door middel van takvrije zone en/of takvrije stam. Als synoniem wordt vaak gebruikt de opkroonhoogte: de verticaal gemeten vrije hoogte tussen maaiveld en kroon van de boom."""@nl ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
