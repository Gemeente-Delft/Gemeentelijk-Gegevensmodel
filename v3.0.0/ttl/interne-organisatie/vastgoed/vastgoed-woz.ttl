<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/adresseerbaarobject> a mim:Objecttype,
        owl:Class ;
    rdfs:label "AdresseerbaarObject"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/adresseerbaarobject/identificatie>,
