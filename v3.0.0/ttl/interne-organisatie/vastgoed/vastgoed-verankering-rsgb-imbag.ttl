<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/enumeratiesoort/typeringappartementsrechtsplitsing/hoofdsplitsing> a mim:Enumeratiewaarde,
        skos:Concept,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/enumeratiesoort/typeringappartementsrechtsplitsing> ;
    rdfs:label "hoofdsplitsing"@nl ;
    mim:code "1" ;
    mim:definitie "Een hoofdSplitsing is een appartementsrechtsplitsing en vormt het geheel van rechten op 1 of meer percelen, dat is gesplitst in appartementsrechten. De hoofdsplitsing kent een ' hoofd Vereniging van eigenaren'. De tekening van het complex is samen met de akte van splitsing ingeschreven in de openbare registers."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/enumeratiesoort/typeringappartementsrechtsplitsing/hoofdsplitsing"^^xsd:anyURI ;
