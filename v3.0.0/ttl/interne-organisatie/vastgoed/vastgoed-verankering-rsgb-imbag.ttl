<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/appartementsrechtsplitsing> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Appartementsrechtsplitsing"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/appartementsrechtsplitsing/ddentificatieappartementsrechtsplitsing>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/appartementsrechtsplitsing/typesplitsing> ;
    mim:datumOpname "2016-05-01"^^xsd:date ;
    mim:definitie "Het recht op een stuk grond of op een gebouw met toebehoren op de daarbij behorende grond met toebehoren is gesplitst in appartementsrechten."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/appartementsrechtsplitsing"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Appartementsrechtsplitsing"@nl ;
    mim:toelichting "Een appartementsrechtsplitsing is een object dat beoogt ten behoeve van een splitsing in appartementsrechten, de in de splitsing betrokken rechten administratief samen te voegen. De appartementsrechtsplitsing omvat het geheel van rechten op een of meer kadastrale objecten dat is (onder) gesplitst in appartementsrechten. Een appartementsrechtsplitsing is een hoofdsplitsing of een ondersplitsing of een splitsingafkooperfpacht."@nl ;
    dcterms:identifier "EAID_C1542AC8_2F3C_4e62_ADFA_A9FB3358DAB1" ;
    rdfs:comment "Het recht op een stuk grond of op een gebouw met toebehoren op de daarbij behorende grond met toebehoren is gesplitst in appartementsrechten."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/> .

