<https://lod.gemeentelijkgegevensmodel.nl/kern/rgbzplus/medewerker> a owl:Class ;
    rdfs:label "Medewerker"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een medewerker van de organisatie die zaken behandelt uit hoofde van zijn of haar functie binnen een ORGANISATORISCHE EENHEID."@nl ;
    dct:identifier "16EB3936-03CB-4854-9CD8-9F0911EEA51B" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rgbzplus/zaak> a owl:Class ;
    rdfs:label "Zaak"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een samenhangende hoeveelheid werk met een welgedefinieerde aanleiding en een welgedefinieerd eindresultaat, waarvan kwaliteit en doorlooptijd bewaakt moeten worden."@nl ;
    dct:identifier "649EFD86-ED52-4293-8577-DBE5445845BF" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rgbzplus/klantcontact> a owl:Class ;
    rdfs:label "Klantcontact"@nl ;
    ggm:objectType "Class" ;
    dct:description "Klantcontacten zijn contactmomenten die werkelijk hebben plaatsgevonden, terwijl Balieafspraken afspraken zijn voor een klantcontact. Dit ongeacht of deze werkelijk heeft plaatsgevonden, soms liggen deze in de toekomst of is iemand niet op komen dagen, of iets anders waardoor het klantcontact nog niet heeft plaatsgevonden. Hetzelfde geldt voor de telefoontjes, de klantcontacten komen uit levelOneData, dat zijn alle telefoontjes die werkelijk met een medewerker (of een gedelegeerde) hebben plaatsgevonden (soms zelfs meerdere binnen 1 telefoontje)."@nl ;
    dct:identifier "A3DAD553-0E55-4256-824B-CDB5E12CB545" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rgbzplus/vestigingvanzaakbehandelendeorganisatie> a owl:Class ;
    rdfs:label "VestigingVanZaakbehandelendeOrganisatie"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een VESTIGING van een onderneming of rechtspersoon zijnde de zaakbehandelende organisatie."@nl ;
    dct:identifier "D8142B98-64CB-408e-9941-92423543F08A" .

