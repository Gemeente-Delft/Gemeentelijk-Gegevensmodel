    ggm:objectType "Class" ;
    dct:description "Uren inzet die gepleegd wordt in een bepaalde periode op een organisatorische eenheid en het percentage dat ook daadwerkelijk wordt uitgevoerd.Dit kan afwijken van de contractuele uren."@nl ;
    dct:identifier "532191CA-13CC-4500-93C9-54AB2862F38D" .

<https://lod.gemeentelijkgegevensmodel.nl/interne_organisatie/hr/normprofiel> a owl:Class ;
