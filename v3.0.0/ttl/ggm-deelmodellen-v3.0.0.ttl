<https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/inburgering/inburgeraar> a owl:Class ;
    rdfs:label "Inburgeraar"@nl ;
    dct:description "De gemeente gaat inburgeringsplichtige nieuwkomers begeleiden bij hun inburgering. Voor asielstatushouders doen zij dit vanaf het moment van koppeling aan een gemeente"@nl ;
    dct:identifier "EE5472C2-193E-4432-B175-78D6DF1D357B" ;
    rdfs:subClassOf <https://lod.gemeentelijkgegevensmodel.nl/sociaal_domein/inburgering/vreemdeling> ;
