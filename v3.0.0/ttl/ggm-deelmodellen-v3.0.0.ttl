<https://lod.gemeentelijkgegevensmodel.nl/interne_organisatie/ict/datatype/herkomst> a rdf:Property ;
    rdfs:label "herkomst"@nl ;
    dct:description "De registratie in wiens catalogus het objecttype is gespecificeerd (oftewel de registratie waar het objecttype deel van uitmaakt). Deze specificatie is toegevoegd omdat het wel duidelijk moet zijn in welke (basis)registratie of informatiemodel het objecttype voorkomt (indien van toepassing)."@nl ;
    dct:identifier "BD3FA19F-6899-4497-AD3F-3E8562B9B9EE" ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/interne_organisatie/ict/datatype> ;
    rdfs:range xsd:string .

