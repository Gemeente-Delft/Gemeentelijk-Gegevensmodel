<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/begingeldigheid> a rdf:Property ;
    rdfs:label "beginGeldigheid"@nl ;
    dct:description "Definitie BeginGeldigheid is de datum waarop een versie van een BAG-object geldig is in de werkelijkheid conform de ingangsdatum in het brondocument. Dit tijdstip wordt vastgelegd in de beginGeldigheid. Als er geen expliciete ingangsdatum van geldigheid is opgenomen, wordt de datum van het brondocument overgenomen. Beschrijving Vanaf deze datum zijn gegevens in de BAG geldig. Bij elke verandering in de BAG zetten we een datum BeginGeldigheid . Wanneer er geen startdatum van geldigheid is, dan gebruiken we de datum van het brondocument als startdatum"@nl ;
    dct:identifier "D9EEC4B0-62B8-40c2-96C4-E8C25A14372A" ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats> ;
    rdfs:range xsd:date .

<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/datumeinde> a rdf:Property ;
    rdfs:label "datumEinde"@nl ;
    dct:description "De datum waarop de object in de BAG formeel is ingetrokken."@nl ;
    dct:identifier "14F96E9A-2AF0-4e11-B8FE-71B528B363CC" ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats> ;
    rdfs:range xsd:date .

<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/datumingang> a rdf:Property ;
    rdfs:label "datumIngang"@nl ;
