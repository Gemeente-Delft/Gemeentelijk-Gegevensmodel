    dct:identifier "CD895AD0-9EB8-4dec-9765-C3A68814079A" ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats> ;
    rdfs:range xsd:date .

<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/documentdatum> a rdf:Property ;
    rdfs:label "documentdatum"@nl ;
    dct:description "De datum waarop het brondocument is vastgesteld"@nl ;
    dct:identifier "10D96D70-98E8-45da-80BF-9E20DFACA99C" ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats> ;
    rdfs:range xsd:date .

<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/standplaats/documentnummer> a rdf:Property ;
    rdfs:label "documentnummer"@nl ;
    dct:description "Het unieke nummer van het brondocument"@nl ;
    dct:identifier "407F33F7-0B2C-4f89-9947-536E0D2BDFAB" ;
