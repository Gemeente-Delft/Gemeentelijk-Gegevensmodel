<https://lod.gemeentelijkgegevensmodel.nl/interne_organisatie/ict/datatype/domein> a rdf:Property ;
    rdfs:label "domein"@nl ;
    dct:description "Domein is zelf geen metadata aspect. Onder het kopje ‘domein’ vallen een aantal metadata aspecten die gelden voor een waarde, oftewel de eisen waaraan een waarde van een attribuutsoort moet voldoen."@nl ;
    dct:identifier "97D23359-0986-4f80-BC78-2FF05445894A" ;
