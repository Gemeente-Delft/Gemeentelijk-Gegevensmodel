<https://lod.gemeentelijkgegevensmodel.nl/interne_organisatie/ict/datatype/patroon> a rdf:Property ;
    rdfs:label "patroon"@nl ;
    dct:description "Alleen van toepassing wanneer het type van het attribuutsoort een primitief datatype is. De verzameling van waarden die gegevens van deze attribuutsoort kunnen hebben, dat wil zeggen het waardenbereik, uitgedrukt in een specifieke structuur."@nl ;
    dct:identifier "29E35085-2DDE-438a-9747-BE32EA8F6E9C" ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/interne_organisatie/ict/datatype> ;
    rdfs:range xsd:string .

