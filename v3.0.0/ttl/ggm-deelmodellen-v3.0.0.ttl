    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/wijk> ;
    rdfs:range xsd:string .

<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/wijk/datumingang> a rdf:Property ;
    rdfs:label "datumIngang"@nl ;
