<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb_model/tenaamstelling> a owl:Class ;
    rdfs:label "Tenaamstelling"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een TENAAMSTELLING vormt de relatie tussen een Recht en een Persoon en geeft aan welk recht, met uitzondering van hypotheek en beslag, door een Persoon wordt uitgeoefend op een Kadastraal object."@nl ;
    dct:identifier "2651D6E0-6AC8-43a8-A4F6-4706209BAC8E" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb_model/aantekening> a owl:Class ;
    rdfs:label "Aantekening"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een Aantekening is een aanvulling op de registratie van een registergoed met betrekking tot feiten die gevolgen kunnen hebben voor de uitoefening van de rechten op dit registergoed."@nl ;
    dct:identifier "755B80B2-6522-4c58-A998-D3F00859FE78" .

