<https://lod.gemeentelijkgegevensmodel.nl/veiligheid_en_vergunningen/producttype> a owl:Class ;
    rdfs:label "Producttype"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een *producttype* is een categorie of variant van producten die dezelfde aard of kenmerken delen, waarmee producten binnen een groep worden ingedeeld op basis van gemeenschappelijke eigenschappen."@nl ;
    dct:identifier "03B4B3C0-3616-4ea2-A8B1-3D6754325F02" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rgbzplus/bedrijfsprocestype> a owl:Class ;
    rdfs:label "Bedrijfsprocestype"@nl ;
    ggm:objectType "Class" ;
    dct:description "soort Bedrijfsproces met bepaalde kenmerken"@nl ;
    dct:identifier "14E4AF23-21E9-412a-B78D-C208EE9F419D" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rgbzplus/deelproces> a owl:Class ;
    rdfs:label "Deelproces"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een geordende reeks van processtappen die binnen één organisatorische eenheid binnen een organisatie wordt uitgevoerd met als doel een specifieke bijdrage (prestatie) te leveren aan een dienst die uiteindelijke zal worden geleverd aan een burger, een bedrijf of een andere organisatie. Voorheen 'werkproces' genoemd."@nl ;
    dct:identifier "1B65D674-DC17-40e8-B663-85DA82FD7E94" .

<https://lod.gemeentelijkgegevensmodel.nl/kern/rgbzplus/zaak> a owl:Class ;
    rdfs:label "Zaak"@nl ;
    ggm:objectType "Class" ;
    dct:description "Een samenhangende hoeveelheid werk met een welgedefinieerde aanleiding en een welgedefinieerd eindresultaat, waarvan kwaliteit en doorlooptijd bewaakt moeten worden."@nl ;
    dct:identifier "649EFD86-ED52-4293-8577-DBE5445845BF" .

