<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/inkomsten/draagkracht> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Draagkracht"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/inkomsten/draagkracht/einddatum>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/inkomsten/draagkracht/startdatum> ;
    mim:definitie "Het gedeelte uit je inkomen of vermogen dat je zelf zou kunnen bijdragen in de kosten (?) voor de bijzondere bijstand(?).De draagkracht is de uitkomst van een ingewikkelde berekening maar wordt voor een jaar vastgesteld en gebruikt.Let wel: niet alle gegevens, die nodig zijn om de draagkracht te berekenen, zijn opgenomen in de ontologie inkomen, omdat bepaalde gegevens van buiten het inkomensdomein komen."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/inkomsten/draagkracht"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Draagkracht"@nl ;
    dcterms:identifier "EAID_9e03b696_a4f8_4486_a5d3_52483f259ed2" ;
    rdfs:comment "Het gedeelte uit je inkomen of vermogen dat je zelf zou kunnen bijdragen in de kosten (?) voor de bijzondere bijstand(?).De draagkracht is de uitkomst van een ingewikkelde berekening maar wordt voor een jaar vastgesteld en gebruikt.Let wel: niet alle gegevens, die nodig zijn om de draagkracht te berekenen, zijn opgenomen in de ontologie inkomen, omdat bepaalde gegevens van buiten het inkomensdomein komen."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/inkomsten/> .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/inkomsten/heffingskorting> a mim:Objecttype,
