        owl:Class ;
    rdfs:label "WOZ-object"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/woz-object/datumbegingeldigheidwozobject>,
