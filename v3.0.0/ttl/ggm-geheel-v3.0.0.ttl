<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/verblijfplaats-azc> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Verblijfplaats AZC"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/verblijfplaats-azc/huisnummer>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/verblijfplaats-azc/straatnummer> ;
    mim:definitie "<font color=\"#0e0e0e\"><b>Verblijfplaats AZC</b></font><font color=\"#0e0e0e\"> is de formele verblijfslocatie van een asielgerechtigde of inburgeringsplichtige binnen een Asielzoekerscentrum (AZC), beheerd door het Centraal Orgaan opvang Asielzoekers (COA), voorafgaand aan of tijdens het inburgeringstraject.</font>"@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/verblijfplaats-azc"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Verblijfplaats AZC"@nl ;
    mim:toelichting "•	In het kader van de Wet inburgering 2021 begint de inburgeringsplicht voor statushouders op het moment dat zij worden ingeschreven in de BRP van een gemeente, meestal na uitstroom uit het AZC."@nl ;
    dcterms:identifier "EAID_40C9655E_15CF_4b46_8B59_FD8D4CBC57B5" ;
    rdfs:comment "<font color=\"#0e0e0e\"><b>Verblijfplaats AZC</b></font><font color=\"#0e0e0e\"> is de formele verblijfslocatie van een asielgerechtigde of inburgeringsplichtige binnen een Asielzoekerscentrum (AZC), beheerd door het Centraal Orgaan opvang Asielzoekers (COA), voorafgaand aan of tijdens het inburgeringstraject.</font>"@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/> .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/vrijstelling> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Vrijstelling"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/vrijstelling/datumvrijstelling>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/vrijstelling/eindoordeelvrijstelling> ;
    mim:definitie "<font color=\"#0e0e0e\">Een </font><font color=\"#0e0e0e\"><b>Vrijstelling</b></font><font color=\"#0e0e0e\"> is een formeel besluit waarbij een inburgeringsplichtige geheel of gedeeltelijk wordt ontheven van specifieke onderdelen van de inburgeringsplicht, omdat deze reeds op andere wijze zijn behaald of niet van toepassing zijn, zoals bedoeld in artikel 7.2 van de Wet inburgering 2021.</font>"@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/vrijstelling"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Vrijstelling"@nl ;
    dcterms:identifier "EAID_C31D4A7E_1F25_4b85_B49C_AEC45EB3DB54" ;
    rdfs:comment "<font color=\"#0e0e0e\">Een </font><font color=\"#0e0e0e\"><b>Vrijstelling</b></font><font color=\"#0e0e0e\"> is een formeel besluit waarbij een inburgeringsplichtige geheel of gedeeltelijk wordt ontheven van specifieke onderdelen van de inburgeringsplicht, omdat deze reeds op andere wijze zijn behaald of niet van toepassing zijn, zoals bedoeld in artikel 7.2 van de Wet inburgering 2021.</font>"@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/> .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/betalingsblokkade> a mim:Objecttype,
