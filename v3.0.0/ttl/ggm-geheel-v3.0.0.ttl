<https://lod.gemeentelijkgegevensmodel.nl/veiligheid-en-vergunningen/vth/beoordelingsoort> a mim:Enumeratie,
        owl:Class,
        skos:ConceptScheme ;
    rdfs:label "Beoordelingsoort"@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/veiligheid-en-vergunningen/vth/beoordelingsoort"^^xsd:anyURI ;
