    mim:indicatieAbstractObject false ;
    mim:naam "Spoor"@nl ;
    mim:toelichting "In enge zin is het een afdruk in de grond, bijvoorbeeld van schoenen, voeten, poten of banden. Meer algemeen worden ook andere veranderingen op een locatie of route sporen genoemd, en, nog algemener, ook andere aanwijzingen voor te achterhalen informatie."@nl ;
    dcterms:identifier "EAID_14939C33_2DCE_41bf_A2BE_FF1EDD292FE7" ;
    rdfs:comment "Een blijk van eerdere aanwezigheid."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sport-cultuur-en-recreatie/erfgoed/archeologie/> .

