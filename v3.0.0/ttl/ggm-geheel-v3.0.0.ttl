<https://lod.gemeentelijkgegevensmodel.nl/enumeraties/typeringwaterplus/rivier> a mim:Enumeratiewaarde,
        skos:Concept,
        <https://lod.gemeentelijkgegevensmodel.nl/enumeraties/typeringwaterplus> ;
    rdfs:label "rivier"@nl ;
    mim:definitie """Het water, dat ten atmosferische neerslag op hellende terreinen 
valt, vloeit, voor zover het niet verdampt of door planten wordt 
opgenomen, tezamen tot een waterloop en stroomt naar 
laaggelegen streken. Zulk een natuurlijke afvloeiing heet een 
rivier."""@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/enumeraties/typeringwaterplus/rivier"^^xsd:anyURI ;
    mim:naam "rivier"@nl ;
    dcterms:identifier "EAID_378815D0_1E69_452e_BFB2_12057B87DDD8" ;
