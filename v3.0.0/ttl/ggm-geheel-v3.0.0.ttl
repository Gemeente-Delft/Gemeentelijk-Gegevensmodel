<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep/eu-burgers> a mim:Enumeratiewaarde,
        skos:Concept,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep> ;
    rdfs:label "EU-burgers"@nl ;
    mim:definitie """Burgers uit EU- en EER-landen die vrijwillig Nederlands willen leren en actief willen deelnemen aan de Nederlandse samenleving.

**Kenmerken:**
<font color="#1400c4">-</font> Vrijwillige deelname aan inburgerings- of taalactiviteiten  
<font color="#1400c4">-</font> Vaak gebruik van gemeentelijk aanbod of laagdrempelige voorzieningen  
<font color="#1400c4">-</font> Focus op praktische taal en maatschappelijke ori&#235;ntatie"""@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep/eu-burgers"^^xsd:anyURI ;
    mim:naam "EU-burgers"@nl ;
    dcterms:identifier "EAID_7157A93A_A6AE_4032_BCCC_0B89F252CFDA" ;
    skos:definition """Burgers uit EU- en EER-landen die vrijwillig Nederlands willen leren en actief willen deelnemen aan de Nederlandse samenleving.

**Kenmerken:**
<font color="#1400c4">-</font> Vrijwillige deelname aan inburgerings- of taalactiviteiten  
<font color="#1400c4">-</font> Vaak gebruik van gemeentelijk aanbod of laagdrempelige voorzieningen  
<font color="#1400c4">-</font> Focus op praktische taal en maatschappelijke ori&#235;ntatie"""@nl ;
    skos:inScheme <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep> ;
    skos:prefLabel "EU-burgers"@nl ;
    skos:topConceptOf <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep> .

