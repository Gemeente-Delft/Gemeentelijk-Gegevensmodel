    rdfs:label "BeoordelingAanvraagVerlenging"@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/beoordelingaanvraagverlenging"^^xsd:anyURI ;
