<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Waardepeiling"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling/bijgevoegd-bewijs>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling/brontype>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling/datum-aanspraak-vermogenscomponent>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling/link-naar-bewijs>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling/peilmoment>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling/waarde-vermogenscomponent>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling/waardepeilingid>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling/waardesoort-vermogenscomponent> ;
    mim:definitie "*Waardepeiling* is een **bepaling of schatting van de waarde van een object, goed of situatie**, verkregen door middel van peiling of inschatting van wat het waard zou zijn."@nl ;
    mim:herkomstDefinitie "De betekenis van *waarde* als bepaling van waarde is afgeleid van het lemma *waardebepaling* — de bepaling van de waarde van iets.  [oai_citation:1‡WikiWoordenboek](https://nl.wiktionary.org/wiki/waardebepaling)" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/waardepeiling"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Waardepeiling"@nl ;
    mim:toelichting "De term *waardepeiling* volgt uit de woorddelen: *waarde* (de bepaling van de waarde van iets) en *peiling* (een systematische inschatting of meting). In gebruik (bijvoorbeeld in online fora) betekent het dat iemand vraagt **wat iets volgens anderen waard is**, oftewel een inschatting van de marktwaarde van een object op basis van meningen of observable kenmerken. Dit is vergelijkbaar met een **waardebepaling**: de vaststelling of schatting van de waarde van iets in geld of andere maatstaven door een beoordeling of (markt)analyse."@nl ;
    dcterms:identifier "EAID_1C1EF3EA_888E_945B_4A20_27DB5B434D4C" ;
    rdfs:comment "*Waardepeiling* is een **bepaling of schatting van de waarde van een object, goed of situatie**, verkregen door middel van peiling of inschatting van wat het waard zou zijn."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/sociaal-domein-generiek/vermogen/> .

