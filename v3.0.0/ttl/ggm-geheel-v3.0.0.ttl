<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep/arbeidsmigranten-met-vestigingsintentie> a mim:Enumeratiewaarde,
        skos:Concept,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep> ;
    rdfs:label "Arbeidsmigranten met vestigingsintentie"@nl ;
    mim:definitie """Arbeidsmigranten die oorspronkelijk tijdelijk naar Nederland zijn gekomen, maar zich blijvend willen vestigen.

**Kenmerken:**
<font color="#1400c4">-</font> Combinatie van werken en leren  
<font color="#1400c4">-</font> Behoefte aan praktisch en functioneel taalgebruik  
<font color="#1400c4">-</font> Vaak behoefte aan flexibel en laagdrempelig aanbod"""@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep/arbeidsmigranten-met-vestigingsintentie"^^xsd:anyURI ;
    mim:naam "Arbeidsmigranten met vestigingsintentie"@nl ;
    dcterms:identifier "EAID_469317C7_243F_49e3_9EBD_886CB3699F0D" ;
    skos:definition """Arbeidsmigranten die oorspronkelijk tijdelijk naar Nederland zijn gekomen, maar zich blijvend willen vestigen.

**Kenmerken:**
<font color="#1400c4">-</font> Combinatie van werken en leren  
