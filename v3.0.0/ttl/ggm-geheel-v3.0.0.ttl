    dcterms:identifier "EAID_5A79235C_331F_41d6_B762_7EAE4F2A3FCA" ;
    skos:definition """Een signaal dat niet wordt opgepakt, omdat er recent al een signaal is ontvangen en opgepakt over dezelfde betalingsachterstand van dezelfde vastelastenpartner. De betalingsachterstand is niet hoger geworden. Als de achterstand wel hoger is geworden, moet deze wel worden opgepakt.
Dit eindresultaat wordt teruggekoppeld aan de vastelastenpartner."""@nl ;
    skos:inScheme <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat> ;
    skos:prefLabel "Niet opgepakt: herhaalde melding"@nl ;
    skos:topConceptOf <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat> .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat/niet-opgepakt-onterecht-signaal> a mim:Enumeratiewaarde,
        skos:Concept,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat> ;
    rdfs:label "Niet opgepakt: onterecht signaal"@nl ;
    mim:definitie """Een signaal dat niet wordt opgepakt, omdat:
<ul>
	<li>de gemelde achterstand lager is dan het drempelbedrag dat de gemeente hanteert, of;</li>
	<li>het aantal dagen achterstand te hoog of te laag is.</li>
</ul>
Dit eindresultaat wordt teruggekoppeld aan de vastelastenpartner."""@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat/niet-opgepakt-onterecht-signaal"^^xsd:anyURI ;
    mim:naam "Niet opgepakt: onterecht signaal"@nl ;
    dcterms:identifier "EAID_16425ABA_C902_4291_98DA_AC8C1C6F80FD" ;
    skos:definition """Een signaal dat niet wordt opgepakt, omdat:
<ul>
	<li>de gemelde achterstand lager is dan het drempelbedrag dat de gemeente hanteert, of;</li>
	<li>het aantal dagen achterstand te hoog of te laag is.</li>
</ul>
Dit eindresultaat wordt teruggekoppeld aan de vastelastenpartner."""@nl ;
