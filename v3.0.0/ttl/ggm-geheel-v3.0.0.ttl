<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/codeopleidingsnaam> a mim:Enumeratie,
        owl:Class,
        skos:ConceptScheme ;
    rdfs:label "CodeOpleidingsnaam"@nl ;
