    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/veiligheid-en-vergunningen/vth/vorderingregel/aangemaakt-door>,
        <https://lod.gemeentelijkgegevensmodel.nl/veiligheid-en-vergunningen/vth/vorderingregel/aanmaakdatum>,
