<https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Balieafspraak"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/eindtijdgepland>,
        <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/notitie>,
        <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/starttijdgepland>,
        <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/tijdaangemaakt>,
        <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/tijdsduurgepland>,
        <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/toelichting>,
        <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/wachttijdnastartafspraak>,
        <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/wachttijdtotaal>,
        <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/wachttijdvoorstartafspraak>,
        <https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak/werkelijketijdsduur> ;
    mim:definitie "Balieafspraken zijn afspraken voor een klantcontact. Dit ongeacht of deze werkelijk heeft plaatsgevonden of gaat plaatsvinden, soms liggen deze in de toekomst of is iemand niet op komen dagen, of iets anders waardoor het klantcontact nog niet heeft plaatsgevonden."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/dienstverlening/balieafspraak"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Balieafspraak"@nl ;
    mim:toelichting "Dit ongeacht of deze werkelijk heeft plaatsgevonden of gaat plaatsvinden, soms liggen deze in de toekomst of is iemand niet op komen dagen, of iets anders waardoor het klantcontact nog niet heeft plaatsgevonden."@nl ;
    dcterms:identifier "EAID_631FEEF1_88D3_4d18_ADB2_BF999068493E" ;
    rdfs:comment "Balieafspraken zijn afspraken voor een klantcontact. Dit ongeacht of deze werkelijk heeft plaatsgevonden of gaat plaatsvinden, soms liggen deze in de toekomst of is iemand niet op komen dagen, of iets anders waardoor het klantcontact nog niet heeft plaatsgevonden."@nl ;
