    rdfs:label "identificatieIMGeoBRT"@nl ;
    mim:datumOpname "2016-05-01"^^xsd:date ;
    mim:definitie "De unieke identificatie van de buurt zoals is toegekend in de IMGeo administratie"@nl ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:herkomst "BGT" ;
    mim:herkomstDefinitie "BGT" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/gebied/identificatieimgeobrt"^^xsd:anyURI ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:indicatieFormeleHistorie true ;
    mim:indicatieMaterieleHistorie false ;
    mim:kardinaliteit "0..1" ;
    mim:mogelijkGeenWaarde false ;
    mim:naam "identificatieIMGeoBRT"@nl ;
    mim:patroon """NL.IMGEO.xxxx. Het 1e deel is de landcode, het 2e deel is de code voor het sectormodel. Het derde deel is de combinatie van de (viercijferige) gemeentecode (volgens BRP stamtabel A.5.4 Gemeente), de tweecijferige code voor het type geoobject (01) en een voor het betreffende objecttype binnen een gemeente unieke tiencijferige objectvolgnummer.

Identificatie is maximaal 25 alfanumerieke tekens lang.Zie voor verdere specificaties datatype NEN3610ID.""" ;
    mim:toelichting "In het IMGeo betreft dit de identificatie van het overeenkomstige geo-object WIJK."@nl ;
    mim:type mim:CharacterString ;
    dcterms:identifier "EAID_5A872FE6_E2AA_48c2_9CD9_483AB3ED189D" ;
    rdfs:comment "De unieke identificatie van de buurt zoals is toegekend in de IMGeo administratie"@nl ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/gebied> ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/> ;
    rdfs:range xsd:string .

