        owl:Class ;
    rdfs:label "MaatschappelijkeActiviteit"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/maatschappelijkeactiviteit/adrescorrespondentie>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/rsgbplus/rsgb/kern-rsgb/maatschappelijkeactiviteit/datumaanvang>,
