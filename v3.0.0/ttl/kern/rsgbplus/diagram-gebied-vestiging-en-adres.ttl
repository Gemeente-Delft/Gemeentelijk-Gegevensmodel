<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte> a mim:Objecttype,
        owl:Class ;
    rdfs:label "OpenbareRuimte"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/begingeldigheid>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/datumeinde>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/datumingang>,
