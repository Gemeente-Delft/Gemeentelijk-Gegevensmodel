<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte> a mim:Objecttype,
        owl:Class ;
    rdfs:label "OpenbareRuimte"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/begingeldigheid>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/datumeinde>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/datumingang>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/documentdatum>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/documentnummer>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/eindgeldigheid>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/geconstateerd>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/geometrie>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/openbareruimte/huisnummerrange-even-en-oneven-nummers>,
