<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/pand> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Pand"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/pand/begingeldigheid>,
        <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/pand/brutoinhoudpand>,
