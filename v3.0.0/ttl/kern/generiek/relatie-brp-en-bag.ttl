<https://lod.gemeentelijkgegevensmodel.nl/kern/bag/nummeraanduiding/begingeldigheid> a mim:Attribuutsoort,
        owl:DatatypeProperty ;
    rdfs:label "beginGeldigheid"@nl ;
    mim:definitie "Definitie BeginGeldigheid is de datum waarop een versie van een BAG-object geldig is in de werkelijkheid conform de ingangsdatum in het brondocument. Dit tijdstip wordt vastgelegd in de beginGeldigheid. Als er geen expliciete ingangsdatum van geldigheid is opgenomen, wordt de datum van het brondocument overgenomen. Beschrijving Vanaf deze datum zijn gegevens in de BAG geldig. Bij elke verandering in de BAG zetten we een datum BeginGeldigheid . Wanneer er geen startdatum van geldigheid is, dan gebruiken we de datum van het brondocument als startdatum"@nl ;
    mim:heeftTijdlijnGeldigheid false ;
    mim:heeftTijdlijnRegistratie false ;
    mim:herkomst "BAG" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/kern/bag/nummeraanduiding/begingeldigheid"^^xsd:anyURI ;
    mim:indicatieAfleidbaar false ;
    mim:indicatieClassificerend false ;
    mim:indicatieFormeleHistorie false ;
    mim:indicatieMaterieleHistorie false ;
    mim:kardinaliteit "1..1" ;
    mim:mogelijkGeenWaarde false ;
    mim:naam "beginGeldigheid"@nl ;
    mim:type mim:Date ;
    dcterms:identifier "EAID_468C1EFF_D57B_4401_B79D_05185F4AD592" ;
    rdfs:comment "Definitie BeginGeldigheid is de datum waarop een versie van een BAG-object geldig is in de werkelijkheid conform de ingangsdatum in het brondocument. Dit tijdstip wordt vastgelegd in de beginGeldigheid. Als er geen expliciete ingangsdatum van geldigheid is opgenomen, wordt de datum van het brondocument overgenomen. Beschrijving Vanaf deze datum zijn gegevens in de BAG geldig. Bij elke verandering in de BAG zetten we een datum BeginGeldigheid . Wanneer er geen startdatum van geldigheid is, dan gebruiken we de datum van het brondocument als startdatum"@nl ;
    rdfs:domain <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/nummeraanduiding> ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/kern/bag/> ;
    rdfs:range xsd:date .

