<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat/inwoner-al-bekend-bij-schuldhulpverlening> a mim:Enumeratiewaarde,
        skos:Concept,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat> ;
    rdfs:label "Inwoner al bekend bij schuldhulpverlening"@nl ;
    mim:code "AB" ;
    mim:definitie "Een inwoner is al bekend bij schuldhulpverlening (als particulier of als (ex-)ondernemer). Vanuit vroegsignalering is er contact geweest met de betrokken schuldhulpverlener. Deze neemt contact op met de schuldeiser en inwoner."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumeindresultaat/inwoner-al-bekend-bij-schuldhulpverlening"^^xsd:anyURI ;
    mim:naam "Inwoner al bekend bij schuldhulpverlening"@nl ;
