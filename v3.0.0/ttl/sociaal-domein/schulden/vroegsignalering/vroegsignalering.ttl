<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumsignaalpartner/belastingdienst> a mim:Enumeratiewaarde,
        skos:Concept,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/schulden/vroegsignalering/enumsignaalpartner> ;
