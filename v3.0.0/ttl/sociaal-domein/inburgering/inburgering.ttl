    rdfs:label "Werk"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/werk/ambitie>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/werk/beroep>,
