<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep/oudkomers> a mim:Enumeratiewaarde,
        skos:Concept,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep> ;
    rdfs:label "Oudkomers"@nl ;
    mim:definitie """Personen die al langere tijd in Nederland wonen en alsnog willen inburgeren of hun taal- en participatievaardigheden willen verbeteren.

**Kenmerken:**
- Hebben vaak informele participatie opgebouwd
- Motivatie vanuit werk, opvoeding of maatschappelijke betrokkenheid
- Behoefte aan maatwerk en herkenning van bestaande vaardigheden"""@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/doelgroep/oudkomers"^^xsd:anyURI ;
