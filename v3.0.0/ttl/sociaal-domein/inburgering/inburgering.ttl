<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pvt> a mim:Objecttype,
        owl:Class ;
    rdfs:label "PVT"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pvt/datumondertekening-pvt>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pvt/redennietvoldaan>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pvt/resultaat>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pvt/verwijtbaarnietvoldaan> ;
    mim:definitie "Het Participatieverklaringstraject (PVT) is een verplicht onderdeel van het inburgeringstraject waarin de inburgeringsplichtige kennismaakt met de basiswaarden van de Nederlandse samenleving, en deze onderschrijft door het ondertekenen van de participatieverklaring."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pvt"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "PVT"@nl ;
    mim:toelichting "Het PVT is geregeld in artikel 7.6 van de Wet inburgering 2021 en maakt onderdeel uit van het wettelijk verplichte inburgeringspakket."@nl ;
    dcterms:identifier "EAID_783B026E_E993_467c_85E0_E90E9E01BAA0" ;
    rdfs:comment "Het Participatieverklaringstraject (PVT) is een verplicht onderdeel van het inburgeringstraject waarin de inburgeringsplichtige kennismaakt met de basiswaarden van de Nederlandse samenleving, en deze onderschrijft door het ondertekenen van de participatieverklaring."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/> .

