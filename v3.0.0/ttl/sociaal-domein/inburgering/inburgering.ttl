<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/leerroute> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Leerroute"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/leerroute/examena2>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/leerroute/geenleerbaarheidstoetszb>,
