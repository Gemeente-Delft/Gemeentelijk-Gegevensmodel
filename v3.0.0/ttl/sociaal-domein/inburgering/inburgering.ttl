<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pip> a mim:Objecttype,
        owl:Class ;
    rdfs:label "PIP"@nl ;
    mim:alias "Persoonlijk Plan Inburgering en Participatie"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pip/dagtekeninginitielepip>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pip/dagtekeningpip>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pip/emailcontactpersoon>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pip/indicatormagopleidingafmaken>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pip/naamcontactpersoon> ;
    mim:definitie "Het Persoonlijk Plan Inburgering en Participatie (PIP) is een individueel plan dat door de gemeente wordt vastgesteld in overleg met de inburgeringsplichtige, waarin het leerrouteadvies, het inburgeringsaanbod, het hoofddoel en de begeleidingsafspraken zijn vastgelegd, met als doel het succesvol afronden van de inburgering binnen de gestelde termijn."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/pip"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "PIP"@nl ;
    mim:toelichting "•	Het PIP wordt opgesteld na de brede intake en op basis van onder meer de leerbaarheidstoets, diplomawaardering en persoonlijke omstandigheden (artikel 17 van de Wet inburgering 2021)."@nl ;
    dcterms:identifier "EAID_94EB7844_F863_4330_A15A_06ED4D1401E0" ;
    rdfs:comment "Het Persoonlijk Plan Inburgering en Participatie (PIP) is een individueel plan dat door de gemeente wordt vastgesteld in overleg met de inburgeringsplichtige, waarin het leerrouteadvies, het inburgeringsaanbod, het hoofddoel en de begeleidingsafspraken zijn vastgelegd, met als doel het succesvol afronden van de inburgering binnen de gestelde termijn."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inburgering/> .

