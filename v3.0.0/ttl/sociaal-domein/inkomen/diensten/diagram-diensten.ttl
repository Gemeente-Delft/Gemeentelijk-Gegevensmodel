<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/onderdeel-beschikking> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Onderdeel beschikking"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/onderdeel-beschikking/datum-beschikking-diensttype>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/onderdeel-beschikking/reden-beschikking-diensttype> ;
    mim:definitie "Een beschikking is een voor beroep vatbaar overheidsbesluit. Veelal de op schrift gestelde juridische motivering van de beslissing, met vermelding van de bezwaar en beroepsmogelijkheden. Omdat de aangevraagde dienst uit meerdere onderdelen bestaat en op elk onderdeel wordt beslist, zijn deze beslissingen en hun juridische motivering opgenomen als onderdelen in de beschikking."@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/onderdeel-beschikking"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Onderdeel beschikking"@nl ;
    dcterms:identifier "EAID_0962936F_7373_4176_296A_281C33036B9B" ;
    rdfs:comment "Een beschikking is een voor beroep vatbaar overheidsbesluit. Veelal de op schrift gestelde juridische motivering van de beslissing, met vermelding van de bezwaar en beroepsmogelijkheden. Omdat de aangevraagde dienst uit meerdere onderdelen bestaat en op elk onderdeel wordt beslist, zijn deze beslissingen en hun juridische motivering opgenomen als onderdelen in de beschikking."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/> .

<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/periodiek-dienst-bijz-bijstand> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Periodiek dienst Bijz. bijstand"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/periodiek-dienst-bijz-bijstand/bedrag>,
