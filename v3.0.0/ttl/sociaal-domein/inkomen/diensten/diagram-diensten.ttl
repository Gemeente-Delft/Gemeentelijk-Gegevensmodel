<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/betalingsblokkade> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Betalingsblokkade"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/betalingsblokkade/aanduiding>,
