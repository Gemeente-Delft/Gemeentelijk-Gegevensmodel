<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/leveringscomponent> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Leveringscomponent"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/leveringscomponent/bedrag>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/leveringscomponent/einddatum>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/leveringscomponent/gevalsrubriek>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/diensten/leveringscomponent/omschrijving-afwijking>,
