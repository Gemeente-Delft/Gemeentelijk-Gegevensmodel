<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/wachten-digid> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Wachten DigiD"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/wachten-digid/aanvraagdatum-digid> ;
    mim:definitie "*Wachten DigiD* is een subtype van **Reden afwijkende startdatum** binnen het GBI-Ontologiemodel dat aangeeft dat de ingangsdatum van een inkomensdienst **vertraging oploopt doordat een DigiD nog niet is aangevraagd, geactiveerd of bruikbaar is**."@nl ;
    mim:herkomstDefinitie "GBI - Werkgroep Ontologie" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/wachten-digid"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Wachten DigiD"@nl ;
    mim:toelichting "In het **GBI-model *Reden aanvraag*** wordt *Wachten DigiD* gebruikt om te registreren dat de startdatum van een uitkering of andere inkomensdienst **niet gelijk kan zijn aan de datum van eerste melding** omdat de cliënt moet wachten op een bruikbare DigiD. Een DigiD (Digitale Identiteits- en authenticatiemethode van de Nederlandse overheid) is vaak nodig om digitaal gegevens in te dienen, besluiten elektronisch te ondertekenen of formulieren compleet te maken. Deze vertraging kan de administratieve start van de dienst beïnvloeden en wordt daarom als specifieke reden voor een afwijkende startdatum vastgelegd."@nl ;
    dcterms:identifier "EAID_32633236_e5f5_40eb_a083_fc12c3e8a7f8" ;
    rdfs:comment "*Wachten DigiD* is een subtype van **Reden afwijkende startdatum** binnen het GBI-Ontologiemodel dat aangeeft dat de ingangsdatum van een inkomensdienst **vertraging oploopt doordat een DigiD nog niet is aangevraagd, geactiveerd of bruikbaar is**."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/> ;
    rdfs:subClassOf <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/reden-afwijkende-startdatum> .

