<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/andere-reden-afwijkende-startdatum> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Andere reden afwijkende startdatum"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/andere-reden-afwijkende-startdatum/omschrijvingbijzonderereden> ;
    mim:definitie "*Andere reden afwijkende startdatum* is een omschrijving van een **reden waarom de startdatum van een dienst of uitkering afwijkt van de standaard startdatum**, voor zover deze reden niet onder de standaardcategorieën valt."@nl ;
    mim:herkomstDefinitie "GBI - Werkgroep Ontologie" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/andere-reden-afwijkende-startdatum"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Andere reden afwijkende startdatum"@nl ;
    mim:toelichting "In het GBI-model voor *Reden aanvraag* geeft *Andere reden afwijkende startdatum* een aanvullende aanduiding van een bijzondere reden waarom de startdatum van een dienst (zoals een uitkering) niet samenvalt met de eerste melding of standaardprocedure. Dit kan situaties omvatten die niet worden gedekt door de reguliere subcategorieën (bijv. opname in een instelling, technische vertragingen of wachten op een beslissing van een andere instantie). De startdatum kan hierdoor eerder of later liggen dan de reguliere melddatum. Het objecttype zelf heeft in de GBI-ontologie geen aparte tekstuele definitie, maar volgt uit de context van *Reden afwijkende startdatum* in het model *Reden aanvraag*."@nl ;
    dcterms:identifier "EAID_237c7e1c_5893_475f_be3f_49b629316e1e" ;
    rdfs:comment "*Andere reden afwijkende startdatum* is een omschrijving van een **reden waarom de startdatum van een dienst of uitkering afwijkt van de standaard startdatum**, voor zover deze reden niet onder de standaardcategorieën valt."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/> ;
    rdfs:subClassOf <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/reden-afwijkende-startdatum> .

