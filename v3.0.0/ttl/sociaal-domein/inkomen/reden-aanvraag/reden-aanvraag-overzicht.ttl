<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk> a mim:Objecttype,
        owl:Class ;
    rdfs:label "Gestopt betaald werk"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/afwijsreden-ww-aanvraag>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/bedrijfsadres>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/bedrijfstelefoonnummer>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/contractperiode>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/laatste-salarisdatum>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/minimaal-26-weken-van-36-gewerkt>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/naam-bedrijf>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/ontslagbrief-ontvangen>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/ontslagvergoeding-ontvangen>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/reden-einde-werk>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/specificatie-reden-einde-werk>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/wettelijke-stappen-gezet>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/ww-uitkering-aangevraagd>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk/ziektewet-uitkering-aangevraagd> ;
    mim:definitie "*Gestopt betaald werk* is de situatie waarin iemand **zijn of haar betaalde arbeidsrelatie heeft beëindigd**, waardoor het reguliere inkomen uit werk is komen te vervallen en dit relevant is voor de beoordeling van een uitkeringsaanvraag of inkomenssituatie."@nl ;
    mim:herkomstDefinitie "GBI - Werkgroep Ontologie" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/gestopt-betaald-werk"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Gestopt betaald werk"@nl ;
    mim:toelichting "Binnen gemeentelijke inkomens- en bijstandsadministraties (zoals onder de Participatiewet) speelt de situatie *gestopt betaald werk* een rol bij de vaststelling van rechten en verplichtingen. Het duidt op het moment waarop een persoon niet langer in dienst is en geen loon meer ontvangt, bijvoorbeeld door ontslag, beëindiging van een tijdelijk contract, eigen vertrek of einde arbeidsovereenkomst. Dit kan bepalend zijn voor het recht op bijstand of andere inkomensondersteuning en voor de vaststelling van de startdatum van de uitkering. In de Participatiewet staat het stimuleren van deelname aan reguliere arbeid centraal, maar als iemand stopt met betaald werk zonder voldoende inkomen volgt mogelijk een aanvraag voor bijstand."@nl ;
    dcterms:identifier "EAID_16333246_B1C9_E9E9_D5B6_2791C02E05CB" ;
    rdfs:comment "*Gestopt betaald werk* is de situatie waarin iemand **zijn of haar betaalde arbeidsrelatie heeft beëindigd**, waardoor het reguliere inkomen uit werk is komen te vervallen en dit relevant is voor de beoordeling van een uitkeringsaanvraag of inkomenssituatie."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/> ;
    rdfs:subClassOf <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/inkomen/reden-aanvraag/reden-aanvraag-levensonderhoud> .

