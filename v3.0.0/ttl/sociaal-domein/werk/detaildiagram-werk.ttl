    mim:definitie "<font color=\"#0e0e0e\"><b>Voorkeur</b></font><font color=\"#0e0e0e\"> is een door de klant geuite wens of voorkeur met betrekking tot werk, opleiding of ondersteuning, waarmee bij de invulling van het re-integratie- of participatietraject rekening kan worden gehouden voor zover dit past binnen de wettelijke kaders en mogelijkheden van de gemeente.</font>"@nl ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/voorkeur"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "Voorkeur"@nl ;
    mim:toelichting "•	Een voorkeur kan betrekking hebben op type werkzaamheden, branche, werkomgeving, werktijden, opleidingsrichting of gewenste ondersteuning."@nl ;
    dcterms:identifier "EAID_A514BC85_0096_4bbc_B393_DE1784056420" ;
    rdfs:comment "<font color=\"#0e0e0e\"><b>Voorkeur</b></font><font color=\"#0e0e0e\"> is een door de klant geuite wens of voorkeur met betrekking tot werk, opleiding of ondersteuning, waarmee bij de invulling van het re-integratie- of participatietraject rekening kan worden gehouden voor zover dit past binnen de wettelijke kaders en mogelijkheden van de gemeente.</font>"@nl ;
