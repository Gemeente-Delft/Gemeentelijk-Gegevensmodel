<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaamgecodeerd> a mim:Objecttype,
        owl:Class ;
    rdfs:label "OpleidingsnaamGecodeerd"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaamgecodeerd/codeopleidingsnaam>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaamgecodeerd/codesoortopleidingsnaam>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaamgecodeerd/indicatieopleidingsnaamactief>,
        <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaamgecodeerd/omschrijvingopleidingsnaam> ;
    mim:definitie "Een OpleidingsnaamGecodeerd is een versleutelde/coderende aanduiding van de naam van een opleiding zoals vastgelegd in onderwijs-microdata, bedoeld om de opleiding te identificeren zonder de volledige tekstuele naam direct in de dataset op te nemen."@nl ;
    mim:herkomstDefinitie "https://www.cbs.nl/nl-nl/onze-diensten/maatwerk-en-microdata/microdata-zelf-onderzoek-doen/microdatabestanden/gebruikershandleiding-onderwijsinformatie?utm_source=chatgpt.com" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaamgecodeerd"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "OpleidingsnaamGecodeerd"@nl ;
    mim:toelichting """•	Deze variabele representeert de opleidingsnaam in gecodeerde vorm, waarbij de feitelijke naam van de opleiding niet als open tekst in het microdata bestand staat.
	•	De gecodeerde naam wordt gebruikt om consistent te koppelen met referentietabellen (zoals opleidingsnummer-referentieboeken) waarin de opleiding met bijbehorende kenmerken (zoals niveau, richting, sector) volledig beschreven staat.
	•	Door gebruik te maken van gecodeerde namen kan CBS data publiceren of beschikbaar stellen zonder direct herleidbare tekstuele beschrijvingen te delen, wat zowel de datakwaliteit als privacy waarborgt."""@nl ;
    dcterms:identifier "EAID_E194EC08_CD47_4429_9598_FDA0AF9E3C2A" ;
    rdfs:comment "Een OpleidingsnaamGecodeerd is een versleutelde/coderende aanduiding van de naam van een opleiding zoals vastgelegd in onderwijs-microdata, bedoeld om de opleiding te identificeren zonder de volledige tekstuele naam direct in de dataset op te nemen."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/> ;
    rdfs:subClassOf <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaam> .

