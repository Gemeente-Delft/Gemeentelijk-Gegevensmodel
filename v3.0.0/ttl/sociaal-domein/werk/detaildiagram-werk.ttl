<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaamongecodeerd> a mim:Objecttype,
        owl:Class ;
    rdfs:label "OpleidingsnaamOngecodeerd"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaamongecodeerd/naamopleidingongecodeerd> ;
    mim:definitie "*OpleidingsnaamOngecodeerd* is de tekstuele naam van een opleiding zoals geregistreerd in CBS-onderwijsdata, weergegeven zonder codering om de opleidingsidentificatie leesbaar te maken."@nl ;
    mim:herkomstDefinitie "https://www.cbs.nl/-/media/cbs-op-maat/microdatabestanden/documents/2025/08/onderwijsinschrtab.pdf" ;
    mim:identificatie "https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaamongecodeerd"^^xsd:anyURI ;
    mim:indicatieAbstractObject false ;
    mim:naam "OpleidingsnaamOngecodeerd"@nl ;
    mim:toelichting """In CBS-microdata-bestanden over onderwijs worden opleidingskenmerken vaak vastgelegd via referentietabellen met een opleidingsnummer (bijv. OPLNR) dat gekoppeld kan worden aan meerdere beschrijvende variabelen:  
- *OpleidingsnaamOngecodeerd* geeft de **onomcodeerde opleidingsnaam**; dit is de begrijpelijke, tekstuele benaming van de opleiding.  
- Dit staat in contrast met variabelen als *OpleidingsnaamGecodeerd*, waarin dezelfde opleiding wordt aangeduid via een code om privacy en koppeling met referentietabellen te waarborgen.  
- De tekstuele naam maakt het eenvoudiger om zonder extra referentietabel te begrijpen om welke opleiding het gaat in analyses en publicaties."""@nl ;
    dcterms:identifier "EAID_5CA681BF_8AC1_4161_921F_F5F78C9DB65F" ;
    rdfs:comment "*OpleidingsnaamOngecodeerd* is de tekstuele naam van een opleiding zoals geregistreerd in CBS-onderwijsdata, weergegeven zonder codering om de opleidingsidentificatie leesbaar te maken."@nl ;
    rdfs:isDefinedBy <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/> ;
    rdfs:subClassOf <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/werk/opleidingsnaam> .

