<https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/generiek-jeugd-en-wmo/jeugd-en-wmo-generiek/aom-aanvraagwmojeugd> a mim:Objecttype,
        owl:Class ;
    rdfs:label "AOM_AanvraagWmoJeugd"@nl ;
    mim:attribuut <https://lod.gemeentelijkgegevensmodel.nl/sociaal-domein/generiek-jeugd-en-wmo/jeugd-en-wmo-generiek/aom-aanvraagwmojeugd/clientreactie>,
