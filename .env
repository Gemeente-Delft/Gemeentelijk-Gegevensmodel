# Voorkomt dat de Python 'translators'-library (dependency van crunch_uml)
# bij import interactief om een serverregio vraagt wanneer de netwerk-
# detectie faalt; dat blokkeert non-interactieve task-runs.
translators_default_region=EN

VERSION=v2.5.1
PREVIOUS_VERSION=v2.5.0
XMI_FILE="Gemeentelijk Gegevensmodel XMI2.1.xml"
GGM_FILE="Gemeentelijk Gegevensmodel.qea"
GGM_MIM_FILE="Gemeentelijk Gegevensmodel-MIM-draft.qea"
EXCEL_FILE="Gemeentelijk Gegevensmodel.xlsx"
LOD_FILE="Gemeentelijk Gegevensmodel Linked Data-draft.ttl"
LINKED_DATA_NS="https://lod.gemeentelijkgegevensmodel.nl"
CHANGES_MD_FILE="GGM_Changes.md"
#EXCEL_FILE="Gemeentelijk Gegevensmodel_Datatypes.xlsx"
#EXCEL_FILE="Gemeentelijk Gegevensmodel_Definities.xlsx"
TRANSLATIONS_DIR="translations"
i18N_FILE="ggm.i18n.json"
ROOT_NODE_GGM="EAPK_D7FD597E_1F40_48df_AFFC_EA3B5B5D3FBF"
# GEMMA-export gebeurt via tools/export_to_gemma.py (taak `generate:gemma`), dat de
# EA .qea rechtstreeks leest en spec-conforme objects/relations-CSV's schrijft.
GEMMA_DIR="gemma"
LANGUAGES=en,fr,de,nb,pl,sv

# SSH/rsync naar testserver. User en sleutel staan in .env-secret.
SSH_HOST="concept.gemeentelijkgegevensmodel.nl"
SSH_REMOTE_DIR="htdocs/concept.gemeentelijkgegevensmodel.nl"
SSH_LOCAL_DIR="site"